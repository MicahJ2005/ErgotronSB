<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction">

    <aura:attribute name="newAccount" type="Object"/>
    <aura:attribute name="simpleNewAccount" type="Object"/>
    <aura:attribute name="newAccountError" type="String"/>
   
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <force:recordData aura:id="accountRecordCreator" 
                      layoutType="FULL"
                      targetRecord="{!v.newAccount}"
                      targetFields="{!v.simpleNewAccount}"
                      targetError="{!v.newAccountError}" />
                      
    <div class="slds-page-header" role="banner">
        <p class="slds-text-heading_label">Create Site Account</p>
    </div>

    <!-- Display Lightning Data Service errors -->
    <aura:if isTrue="{!not(empty(v.newAccountError))}">
        <div class="recordError">
            <ui:message title="Error" severity="error" closable="true">
                {!v.newAccountError}
            </ui:message>
        </div>
    </aura:if>

    <!-- Display the new contact form -->
    <div class="slds-form_stacked">
        <lightning:input aura:id="accountField" name="Name" label="Account Name"
                         value="{!v.simpleNewAccount.Name}" required="true"/>
      
        <lightning:inputAddress aura:id="accountField" name="BillingAddress" label="Address"
                      value="{!v.simpleNewAccount.BillingAddress}" required="true"/>
                      
        <lightning:button label="Save Account" onclick="{!c.handleSaveAccount}"
                   variant="brand" class="slds-m-top_medium"/>
   </div>

</aura:component>