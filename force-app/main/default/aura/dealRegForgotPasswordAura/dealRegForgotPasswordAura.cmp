<aura:component  controller="DealRegRegistrationCtrl" implements="forceCommunity:availableForAllPageTypes">
    <aura:attribute name="displayConfirmation" type="boolean" />
    <aura:attribute name="username" type="String" />
    <aura:attribute name="password" type="String" />
    <aura:attribute name="error" type="String" />
    <lightning:layout multipleRows="true" verticalAlign="stretch" horizontalAlign="spread">
        <aura:if isTrue="{!not(empty(v.error))}">
            <lightning:layoutItem size="12" padding="around-small">
            	<div class="error">{!v.error}</div>
        	</lightning:layoutItem>
        </aura:if>
        <lightning:layoutItem size="12" padding="around-small">
            <label class="slds-form-element__label loginlabel">Username / Corporate Email Address</label>
            <lightning:input variant="label-hidden" type="text" name="uname" label="Username / Corporate Email Address" onchange="{!c.handleUsernameUpdate}" />
        </lightning:layoutItem>
        <lightning:layoutItem size="12" padding="around-small">
            <!-- <button class="login" onclick="{!c.handleReset}">Reset</button>
            <a href="../login"><button class="login">Cancel</button></a> -->
            <p class="btn-blue-wrapper"><a class="btn-blue login" href="#" onclick="{!c.handleReset}">Submit</a>
            <a class="btn-blue-border login cancelbtn" href="../login">Cancel</a>
            </p>
        </lightning:layoutItem>
    </lightning:layout>
</aura:component>