public class cc_Ergo_Ctrl_B2BBuyStuff {
// This class has been superseded by CC_ERG_OrderCreate and should be removed from ecom prior to go-live 
    public ID caseID;
    public ID contactId;  
    
    public cc_Ergo_Ctrl_B2BBuyStuff(){
        
        // the select option to hold the names
        this.PriceListsOptions = new SelectOption[]{};        
        
        caseId = ApexPages.currentPage().getParameters().get('caseID');
         
        // TESTING - REMOVE BEFORE PUTTING INTO PRODUCTION!
        if(String.isBlank(caseID)){
	        caseId = '5001M00001PuFnoQAF'; // closed case for Westchester Medical Center from 9/18. 
        } // END TESTING CODE   
        
        Case theCase = [select Contact.AccountId, Contact.Id from Case where Id = :caseId];
        contactId = theCase.Contact.Id;
        
        Account theAccount = [select ccrz__E_AccountGroup__c from Account where Id = :theCase.Contact.AccountId];

        List<ccrz__E_AccountGroupPriceList__c> accountgrouppricelist = [select ccrz__Pricelist__c, ccrz__Pricelist__r.Name
                                                                          from ccrz__E_AccountGroupPriceList__c 
                                                                         where ccrz__AccountGroup__c = :theAccount.ccrz__E_AccountGroup__c];

        // populates the drop down list, need name in here, not just the id
        // notice there are 2 c's in the SelectOption 
        // SelectOption(value,label,isDisabled)
        // I just used the id

        for(ccrz__E_AccountGroupPriceList__c i: accountgrouppricelist) {
            
            String c = String.valueOf(i.Id);
            String n = i.ccrz__Pricelist__r.Name;
                        
			this.PriceListsOptions.add(new SelectOption(c,n));  // my price list items             
            
        }

    }// end of constructor 
    
    public PageReference continuePressed() {   // for testing, causes page refreash 
        return null;
    }
    
    public string selectedValue{get;set;}
    public String forwardURL{get;set;}
    public List<Id> plIds{get;set;}
	public SelectOption[] PriceListsOptions{get;set;}    
    String OrderType = null; // could set default here....
    List<SelectOption> options = new List<SelectOption>(); 
                 
    public List<SelectOption> getItems() {
       // List<SelectOption> options = new List<SelectOption>(); 
        options.add(new SelectOption('Warranty','Warranty')); 
        options.add(new SelectOption('Non-Warranty','Non-Warranty')); 
        return options; 
    }
 
    public ID ThiscontactId{
        
        get{
            return this.contactId;
        }
        
        set;
    
    }       

        public ID ThisCaseID{
        
        get{
            return this.caseId;
        }
        
        set;
    
    }  
    
    public String ThisUserName{
        
        get{
             user u = [select id, name from user where contactId = :contactId and isActive=TRUE limit 1];
            
             return u.name;
        }
        
        set;
    
    }   
    
    public String getOrderType() {
        return OrderType;
    }
                    
    public void setOrderType(String OrderType) { this.OrderType = OrderType; }
    //     
    // jump to    ccrz__ProductList 
    //  
    public PageReference GoToPLP()
	{
   
    // using Glens code here
        PageReference pageRef = System.Page.ccrz__ProductList;
        
        user u = [select id, name from user where contactId = :contactId and isActive=TRUE limit 1];
        
        ccrz__E_Category__c allProdCatId = [select Id from ccrz__E_Category__c where Name = 'All Products'];
        
        ID categoryID = allProdCatId.Id;
        
        pageRef.getParameters().put('CategoryID', allProdCatId.Id); 
        pageRef.getParameters().put('store', 'DefaultStore'); //hard code for now, but this could be a custom setting.
        pageRef.getParameters().put('CaseID', caseId); // this should come from the current URL param
        pageRef.getParameters().put('portalUser', u.id);    
        
        return pageRef;
	}
	
