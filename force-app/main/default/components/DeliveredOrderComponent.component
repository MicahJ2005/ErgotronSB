<!--
  @description       : Included in a vf email tmeplate.  Email = SalesOrderDelivered
                        Pulls in Shipment information.  Emails are batched out via "DeliveredOrderEmailBatch.cls"
                        Order Date; Order # should go in the email template
  Modifications Log 
  Ver   Date         Author                  Modification
  1.0   12.14.2022   sophiam@demandchain.com Initial creation
  1.1   01.04.2023   sophiam@demandchain.com Updated grid look and feel
-->
<apex:component controller="DeliveredOrderController" access="global">
  <apex:attribute name="SalesOrderID" description="Attribute on the component." type="String" required="required" assignTo="{!theID}"
  />

  <style type="text/css">
      @media (max-width: 300px){
          .td{display: flex;
                flex-wrap: wrap;
                overflow-x: hidden;}
                }
  
  </style>
  <apex:repeat value="{!SalesOrder}" var="theSalesOrder">
      <table>
          <tr>
              <td style="color: #404040;margin-bottom:5px;font-size:14px; display:contents;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;"><strong>Shipping Address</strong></td>
          </tr>
          <tr width="600px">
              <td style="color:#404040;margin-bottom:5px;font-size:14px;display:contents;font-family:verdana,geneva,sans-serif;padding-left:10px;font-weight:normal;">
                  <apex:outputText value="{!theSalesOrder.Shipping_Address__c}" escape="false" />
              </td>
          </tr>
      </table>  
  </apex:repeat>
    <table cellspacing="0" cellpadding="0" style="background: white;margin-top:5px;" border="0">
        <tr>
            <td style="color: #404040;margin-bottom:5px;font-size:14px; display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong><!-- IMAGE --></strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px; display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>Product Name</strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px; display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>SKU</strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px; display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>Qty</strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px; display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>Price</strong>
            </td>
        </tr>
        <apex:repeat value="{!deliveredDetailsList}" var="dd">
            <tr>
                <td style="padding:10px 10px 0px 10px;" rowspan="3">
                    <!-- Image -->
                    <img src="{!dd.productImage}" height="55px"/>
                </td>
                <td style="padding:10px 10px 0px 10px;">
                    <!-- Items Ordered/Product Name (Part Number) -->
                    <apex:outputText value="{!dd.productName}" style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;" />
                </td>
                <td style="padding:10px 10px 0px 10px;text-align:center;">
                    <!--SKU (Product Code)-->
                    <apex:outputText value="{!dd.productSKU}" style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;" />
                </td> 
                <td style="padding:10px 10px 0px 10px;text-align:center;">
                    <!--Quantity-->
                    <apex:outputText value="{!dd.quantity}" style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;" />
                </td> 
                <td style="padding:10px 10px 0px 10px;text-align:right;">
                    <!-- Price -->
                    <apex:outputText value="{!dd.price}" style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;" />
                </td> 
            </tr><tr>
                <td style="padding:10px 10px 0px 10px;text-align:left;" colspan="4">
                    <!--Shipment Status-->
                    <strong style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;">Status: </strong> 
                    <apex:outputText value="{!dd.shipmentStatus}" style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;" />
                </td> 
            </tr> <tr>
                <td style="padding:10px 10px 0px 10px; text-align:left;" colspan="4">
                    <!-- Tracking Number; link or text shows depending on if the link is there (UPS/FEDEX) -->
                    <strong style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;">Tracking Number: </strong> 
                    <apex:outputlink value="{!dd.trackingNumberLink}" rendered="{!CONTAINS(dd.trackingNumberLink, 'https')}" style="color: #1f3662;margin-bottom:5px;font-size:12px; display: contents;font-family:verdana, geneva, sans-serif;text-decoration:none;font-weight;bold;text-decoration:none!important;color:#1f3662;">
                        <strong style="color:#1f3662;">{!dd.trackingNumber}</strong>
                    </apex:outputlink>
                    <apex:outputText value="{!IF((dd.trackingNumber!= null), dd.trackingNumberLink,'TBD')}" rendered="{!NOT(CONTAINS(dd.trackingNumberLink, 'https'))}" style="color: #1f3662;margin-bottom:5px;font-size:12px; display: contents;font-family:verdana, geneva, sans-serif;text-decoration:none;font-weight:bold;" />
                </td>
            </tr>    
            <tr>
                <td colspan="5"><hr style="width:90%" /></td>  
            </tr>      
        </apex:repeat>
    </table>
</apex:component>