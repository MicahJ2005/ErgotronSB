<apex:component controller="Opportunity_Partner_Utility" access="global">
    <apex:attribute name="opptyId" description="Opportunity Id" required="false" type="String" assignTo="{!sOpportunityId}" />
    <html>
        <body>
            <p>Below is a list of distribution and reseller partners identified on this opportunity.</p>
            <table border="0">
                <tr>
                    <th>Partner</th>
                    <th>Role</th>
                    <th>Oracle Party Number</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Country</th>
                </tr>
                <apex:repeat var="oppPartners" value="{!listPartners}">
                    <tr>
                        <td><apex:outputField value="{!oppPartners.Partner_Account__r.Name}"/></td>
                        <td><apex:outputField value="{!oppPartners.Partner_Role__c}"/></td>
                        <td><apex:outputField value="{!oppPartners.Partner_Account__r.Oracle_Party_Number__c}"/></td>
                        <td><apex:outputField value="{!oppPartners.Partner_Account__r.BillingCity}"/></td>
                        <td><apex:outputField value="{!oppPartners.Partner_Account__r.BillingState}"/></td>
                        <td><apex:outputField value="{!oppPartners.Partner_Account__r.BillingCountry}"/></td>                   
                    </tr>
                </apex:repeat>
            </table>
        </body>
    </html>
</apex:component>