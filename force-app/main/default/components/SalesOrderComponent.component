<apex:component controller="SalesOrderController" access="global">
  <apex:attribute name="SalesOrderID" description="Attribute on the component." type="String" required="required" assignTo="{!theID}"
  />

  <style type="text/css">
      @media (max-width: 300px){
          .td{display: flex;
flex-wrap: wrap;
overflow-x: hidden;}
}
  
  </style>
  <apex:repeat value="{!SalesOrder}" var="theSalesOrder">
      <table>
          <tr>
              <td style="color: #404040;margin-bottom:5px;font-size:14px; display:contents;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;"><strong>Shipping Address</strong></td>
          </tr>
          <tr width="600px">
              <td style="color:#404040;margin-bottom:5px;font-size:14px;display:contents;font-family:verdana,geneva,sans-serif;padding-left:10px;font-weight:normal;">
                  <apex:outputText value="{!theSalesOrder.Shipping_Address__c}" escape="false" />
              </td>
          </tr>
      </table>  
  </apex:repeat>
    <table cellspacing="10" style="background: white;margin-top:5px;">
        <tr>
            <td style="color: #404040;margin-bottom:5px;font-size:14px; display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>Tracking Number</strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px; text-transform: capitalize; display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>Items Ordered</strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>Price</strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <strong>Quantity</strong>
            </td>
        </tr>
        <apex:repeat value="{!OrderTrackingNumberList}" var="theOrderTrackingNumber">
            <tr>      
                <td style="padding:10px 10px 0px 10px;">
                <apex:outputText style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;" value="{!theOrderTrackingNumber.Carrier_Code__c}"/>
                    <!-- Tracking Number; link or text shows depending on if the link is there (UPS/FEDEX) -->
                    <apex:outputlink style="color: #1f3662;margin-bottom:5px;font-size:12px; display: contents;font-family:verdana, geneva, sans-serif;text-decoration:none;font-weight;bold;text-decoration:none!important;color:#1f3662;" value="{!theOrderTrackingNumber.Tracking_Number_Link__c}" rendered="{!CONTAINS(theOrderTrackingNumber.Tracking_Number_Link__c, 'https')}">
                        <strong style="color:#1f3662;">{!theOrderTrackingNumber.Tracking_Number__c}</strong>
                    </apex:outputlink>
                    <apex:outputText style="color: #1f3662;margin-bottom:5px;font-size:12px; display: contents;font-family:verdana, geneva, sans-serif;text-decoration:none;font-weight:bold;"  value="{!IF((theOrderTrackingNumber.Tracking_Number__c!= null), theOrderTrackingNumber.Tracking_Number_Link__c,'TBD')}" rendered="{!NOT(CONTAINS(theOrderTrackingNumber.Tracking_Number_Link__c, 'https'))}" />
                </td>
                <td style="padding:10px 10px 0px 10px;">
                    <!-- Items Ordered/Product Name -->
                    <apex:outputText style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;"  value="{!IF(CONTAINS(OrderTrackingID, theOrderTrackingNumber.ID), OrderTrackingNumber2OrderLineNumberMap[theOrderTrackingNumber.ID].CC_Prod_Alternate_Name__c,'')}" />
                </td>
                <td style="padding:10px 10px 0px 10px;">
                    <!-- Price -->
                    <apex:outputText style="color: #404040;margin-bottom:5px;font-size:14px; display: contents;text-align:left;font-family:verdana, geneva, sans-serif;font-weight:normal;" value="{!IF(CONTAINS(OrderTrackingID, theOrderTrackingNumber.ID), OrderTrackingNumber2OrderLineNumberMap[theOrderTrackingNumber.ID].Unit_Selling_Price__c,'')}" />
                </td>
                <td style="padding:10px 10px 0px 10px;text-align:center;">
                    <!--Quantity-->
                    <apex:outputText style="color: #404040;margin-bottom:5px;font-size:14px; display: contents;font-family:verdana, geneva, sans-serif;text-align:center;font-weight:normal;" value="{!IF(CONTAINS(OrderTrackingID, theOrderTrackingNumber.ID), OrderTrackingNumber2OrderLineNumberMap[theOrderTrackingNumber.ID].Shipped_Quantity__c,'')}" />
                </td>
            </tr>           
        </apex:repeat>
    </table>
</apex:component>