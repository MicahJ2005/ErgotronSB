<apex:component controller="SalesOrderLineComponentController" access="global">
    <apex:attribute name="SalesOrder" description="Attribute on the component." type="String" required="required" assignTo="{!recordID}"/>
 
    <table>
        <tr>
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
            <!--    <Strong>
                    Image URL
                </Strong> -->
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
                <Strong>
                    Item
                </Strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 10px;">
                <Strong>
                    Quantity
                </Strong>
            </td>
        </tr>
        <apex:repeat value="{!lstItems}" var="item">
            <tr>
                <td style="padding:10px 10px 0px 10px;">
                    <img src="{!item.imgUrl}" />
                </td>
                <td style="padding:10px 10px 0px 10px;">
                    <apex:outputText style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;"  value="{!item.sku}"/>
                </td>
                <td style="padding:10px 10px 0px 10px;">
                    <apex:outputText style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;"  value="{!item.salesItemQuantity}"/>
                </td>
            </tr>

        </apex:repeat>
    </table>


</apex:component>