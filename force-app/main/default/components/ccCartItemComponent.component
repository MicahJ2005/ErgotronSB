<apex:component controller="ccCartItemController" access="global">
    <apex:attribute name="cartItemID" description="Attribute on the component." type="String" required="required" assignTo="{!recordID}"/>
 
    <table>
        <tr>
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding: 10px 10px 10px 15px;">
               
            </td>
            <!--<td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding:10px 10px 0px 15px;">
                <Strong>
                    Product ID
                </Strong>
            </td>-->
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding: 10px 10px 0px 15px;">
                <Strong>
                  Item
                </Strong>
            </td>
            <td style="color: #404040;margin-bottom:5px;font-size:14px;  display:flex, table-row;font-family:verdana, geneva, sans-serif;text-align:left;padding: 10px 10px 0px 15px">
                <Strong>
                    Quantity
                </Strong>
            </td>
        </tr>
        <apex:repeat value="{!lstItems}" var="item">
            <tr>
                <td style="padding:10px 10px 10px 15px;">
                    <!--<apex:outputlink style="color: #1f3662;margin-bottom:5px;font-size:12px; display: contents;font-family:verdana, geneva, sans-serif;text-decoration:none;font-weight;bold;text-decoration:none!important;color:#1f3662;" value="{!item.imgUrl}">
                        <strong style="color:#1f3662;">{!item.imgUrl}</strong>
                    </apex:outputlink>  -->
                    <img src="{!item.imgUrl}" />
                </td>
                <!--<td style="padding:10px 10px 0px 10px;">
                    <apex:outputText style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;"  value="{!item.productID}"/>
                </td>-->
                <td style="padding:10px 10px 10px 15px;">
                    <apex:outputText style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;"  value="{!item.productName}"/>
                </td>
                <td style="padding:10px 10px 10px 15px;">
                    <apex:outputText style="color: #404040;text-transform: capitalize; margin-bottom:5px;font-size:14px;line-height:20px display: contents;font-family:verdana, geneva, sans-serif;font-weight:normal;"  value="{!item.cartItemQuantity}"/>
                </td>
            </tr>

        </apex:repeat>
    </table>


</apex:component>