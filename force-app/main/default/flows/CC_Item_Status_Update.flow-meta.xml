    <description>Added YotpoShipDate field</description>
    <formulas>
        <description>Stores the object identifier for the Sales Order Line object.</description>
        <name>objectId</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Sales_Order_Line_Object_Id.Id},3)</expression>
    </formulas>
    <formulas>
        <description>Mapping of statuses from Order Line Item Status to CC Order Item Status (ccrz__OrderItemStatus__c)</description>
        <name>statusMap</name>
        <dataType>String</dataType>
        <expression>CASE ({!Order_Line_Item.Status__c},
&quot;Cancelled&quot;, &quot;Cancelled&quot;,
&quot;Closed&quot;, &quot;Shipped&quot;,
&quot;Booked&quot;, &quot;In Process&quot;,
&quot;Awaiting Invoice Interface - On Hold&quot;, &quot;On Hold&quot;,
TEXT({!CC_Item.ccrz__OrderItemStatus__c})
)</expression>
    </formulas>
    <formulas>
        <description>If the status is &apos;shipped&apos;, set to currentDate</description>
        <name>YotpoShippedDateFormula</name>
        <dataType>Date</dataType>
        <expression>IF({!Order_Line_Item.Status__c} =  &apos;Closed&apos;, {!$Flow.CurrentDate}, null)</expression>
    </formulas>
