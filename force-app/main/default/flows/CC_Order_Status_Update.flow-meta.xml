    <decisions>
        <description>Evaluate the tax amount from the Oracle order to determine if the tax amount in the CC Order needs to be revised.</description>
        <name>Evaluate_Tax_Amount</name>
        <label>Evaluate Tax Amount</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Only_CC_Order_Status_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Revise_Tax_Amount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CC_Order.Tax_Amount_Revised__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Order.Tax_Amount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>CC_Order.ccrz__TaxAmount__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Order.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Booked</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CC_Order_Tax_Amount_Update</targetReference>
            </connector>
            <label>Revise Tax Amount</label>
        </rules>
    </decisions>
