    <description>Creates CC Product and CC Product Category when a new Product (Product2) is created. It also creates the corresponding Customer Care USD price book entry.</description>
    <environments>Default</environments>
    <formulas>
        <description>returns true if the item type is either  E-SERVICE or FRT (freight)</description>
        <name>nonInventoryFlag</name>
        <dataType>Boolean</dataType>
        <expression>OR(
{!Product.Item_Type__c} = &apos;E-SERVICE&apos;,
{!Product.Item_Type__c} = &apos;FRT&apos;
)</expression>
    </formulas>
    <formulas>
        <description>Determines the tax group based on the product item-type</description>
        <name>taxGroup</name>
        <dataType>String</dataType>
        <expression>CASE(
{!Product.Item_Type__c},
&quot;E-SERVICE&quot;, &quot;Services &amp; Miscellaneous&quot;,
&quot;FRT&quot;, &quot;Services &amp; Miscellaneous&quot;,
&quot;Physical Goods&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Determines the tax type based on the product item-type</description>
        <name>taxType</name>
        <dataType>String</dataType>
        <expression>CASE(
{!Product.Item_Type__c},
&quot;E-SERVICE&quot;, &quot;General Services&quot;,
&quot;FRT&quot;, &quot;Shipping and Handling&quot;,
&quot;General Merchandise&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Oracle Part Name value truncated to 80 characters.</description>
        <name>TruncatedProdName</name>
        <dataType>String</dataType>
        <expression>LEFT({!Product.Oracle_Part_Name__c},80)</expression>
    </formulas>
