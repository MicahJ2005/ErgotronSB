    <recordLookups>
        <description>Get Campaign Member Statuses that will need to be deleted in the event the campaign type changes.</description>
        <name>Get_CMS_to_delete</name>
        <label>Get CMS to delete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>New_Campaign</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsDefault</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Label</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Connected</stringValue>
            </value>
        </filters>
        <filters>
            <field>Label</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Responded</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CampaignMemberStatus</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_CMS_to_delete2</name>
        <label>Get CMS to delete2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Get_CMS_to_delete_2</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Responded</stringValue>
            </value>
        </filters>
        <filters>
            <field>Label</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Connected</stringValue>
            </value>
        </filters>
        <filters>
            <field>Label</field>
            <operator>NotIn</operator>
            <value>
                <elementReference>ExistingStatuses</elementReference>
            </value>
        </filters>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsDefault</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CampaignMemberStatus</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CMS_to_delete</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.RecordType.Name} = &apos;Child - Marketing Tactic&apos;,
    OR(
        AND(
        ISNEW(),
        NOT(ISBLANK(TEXT({!$Record.Type})))
        ),
        ISCHANGED({!$Record.Type})
    )
)</filterFormula>
        <object>Campaign</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
