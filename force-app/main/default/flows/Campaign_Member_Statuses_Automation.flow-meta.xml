    <description>Creates campaign member statuses in a campaign based on the campaign type.</description>
    <environments>Default</environments>
    <interviewLabel>Campaign Member Statuses Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Campaign Member Statuses Automation</label>
    <loops>
        <description>Loop through the campaign members to get a list of used statuses. These statuses will need to be kept and not deleted.</description>
