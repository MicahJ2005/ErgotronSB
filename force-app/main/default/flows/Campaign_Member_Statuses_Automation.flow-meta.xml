        <label>Loop through Campaign Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Campaign_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Evaluate_PreviousStatus</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
