    <decisions>
        <description>Compare the Oracle order tax amount to the CC Order tax amount to determine whether to update the CC Order tax amount.</description>
        <name>Evaluate_Tax_Amounts</name>
        <label>Evaluate Tax Amounts</label>
        <locationX>182</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Revise_Tax_Amount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Oracle_Order_Tax_Amount.Tax_Amount__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record.ccrz__TaxAmount__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tax_Amount</targetReference>
            </connector>
            <label>Revise Tax Amount</label>
        </rules>
    </decisions>
    <description>This flow ensures that the CC Order’s tax amount matches the Oracle order’s tax amount (if the Oracle amount is lower), and then triggers a Stripe payment capture via Apex, all automatically after the order is updated and flagged for capture.</description>
    <environments>Default</environments>
    <interviewLabel>Capture Payment for Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Capture Payment for Order</label>
