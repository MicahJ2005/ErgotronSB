<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Calls Invocable Apex class that executes the EnhancedNoteMigrationBatch</description>
        <name>EnhancedNoteMigrationBatchLauncher</name>
        <label>EnhancedNoteMigrationBatchLauncher</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>EnhancedNoteMigrationBatchLauncher</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Get_AssyncApexJob</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <nameSegment>EnhancedNoteMigrationBatchLauncher</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_of_Pending_ENMS</name>
        <label>Count of Pending ENMS</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vCountENMS</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_count_of_pending_ENMS_records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Any_Pending</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Any_Pending</name>
        <label>Any Pending?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Nothing_To_Process</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vCountENMS</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Start_Screen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Counts pending Enhanced Note Migration Staging records and allows the user to start the Enhanced Note conversion process. When started, the flow calls the EnhancedNoteMigrationBatchLauncher Apex action, which runs the EnhancedNoteMigrationBatch asynchronously in the background. If no pending records exist, the flow displays a message indicating there is nothing to process.</description>
    <environments>Default</environments>
    <interviewLabel>Convert Staged Notes to Enhanced Notes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Convert Staged Notes to Enhanced Notes</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_AssyncApexJob</name>
        <label>Get AssyncApexJob</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Conversion_Started</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentJobId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EnhancedNoteMigrationBatchLauncher.batchJobId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AsyncApexJob</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_count_of_pending_ENMS_records</name>
        <label>Get count of pending ENMS records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_of_Pending_ENMS</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Processing_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Enhanced_Note_Migration_Staging__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Conversion_Started</name>
        <label>Conversion Started</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Get_AssyncApexJob</targetReference>
        </connector>
        <fields>
            <name>submitted</name>
            <fieldText>&lt;p&gt;Your Enhanced Note conversion has been submitted successfully.&lt;/p&gt;&lt;p&gt;The process is now running in the background and may take several minutes to complete.&lt;/p&gt;&lt;p&gt;You may safely close this screen and continue working while the conversion completes.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Status&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Records Processed: {!Get_AssyncApexJob.LastProcessedOffset}&lt;/p&gt;&lt;p&gt;Failures: {!Get_AssyncApexJob.NumberOfErrors}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Refresh Status</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Nothing_To_Process</name>
        <label>Nothing To Process</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>msgNoPendingRecords</name>
            <extensionName>flowruntime:message</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>messageType</name>
                <value>
                    <stringValue>info</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>messageContent</name>
                <value>
                    <stringValue>No pending records to process. You may close this screen.</stringValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Start_Screen</name>
        <label>Start Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>EnhancedNoteMigrationBatchLauncher</targetReference>
        </connector>
        <fields>
            <name>txtStartScreen</name>
            <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;This process will convert &lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!vCountENMS}&lt;/strong&gt; pending staging records into Enhanced Notes and link them to their target records.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Click &lt;strong&gt;Go &lt;/strong&gt;to start the conversion. The process will run in the background and may take a few minutes to complete.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Go</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_count_of_pending_ENMS_records</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>vCountENMS</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
