        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <outputAssignments>
            <assignToReference>scheduleQty</assignToReference>
            <field>Quantity</field>
        </outputAssignments>
    </recordLookups>
