        <name>Set_schedule_data</name>
        <label>Set schedule data</label>
        <locationX>584</locationX>
        <locationY>50</locationY>
        <assignmentItems>
            <assignToReference>schedule.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Quantity</stringValue>
