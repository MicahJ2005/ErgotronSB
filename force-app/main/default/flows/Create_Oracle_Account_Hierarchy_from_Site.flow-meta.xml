    <decisions>
        <name>Is_Parent_CustOrg</name>
        <label>Is Parent CustOrg and Ready?</label>
        <locationX>810</locationX>
        <locationY>52</locationY>
        <defaultConnector>
            <targetReference>Submit_this_Site_for_Oracle_Hierarchy_Creation_BLOCKED</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, it is not.</defaultConnectorLabel>
        <rules>
            <name>Yes_is_CustOrg</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>soAccountParent.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>soRecordTypeCustomerOrg.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>soAccountSite.Oracle_Site_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_this_Site_for_Oracle_Hierarchy_Creation</targetReference>
            </connector>
            <label>Yes, is CustOrg and Not Submitted</label>
        </rules>
    </decisions>
