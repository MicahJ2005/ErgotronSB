    <decisions>
        <description>Evaluates the product in the triggering opportunity to determine whether to process or skip</description>
        <name>Evaluate_Product</name>
        <label>Evaluate Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Loop_thru_Oppy_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>INITIAL_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_thru_Oppy_Product.Product2.Renewal_Service_Product__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_thru_Oppy_Product.Product2.Product_Detail__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>INITIAL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PriceBookEntryId</targetReference>
            </connector>
            <label>INITIAL Product</label>
        </rules>
        <rules>
            <name>RENEWAL_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_thru_Oppy_Product.Product2.Product_Detail__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RENEWAL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RenewalPriceBookEntryId</targetReference>
            </connector>
            <label>RENEWAL Product</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determine whether to proceed or not</description>
        <name>Evaluate_the_RhythmConnect_Products</name>
        <label>Evaluate the RhythmConnect Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Records_found</name>
            <conditionLogic>and</conditionLogic>
