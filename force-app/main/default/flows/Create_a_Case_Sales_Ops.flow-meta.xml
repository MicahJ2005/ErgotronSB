    <environments>Default</environments>
    <formulas>
        <description>This flag is true if the country is US, MX, CA and the state code is null.</description>
        <name>frmlBolStateRequired</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISBLANK( {!varAcctAddressProvince} ),
OR(
{!varAcctAddressCountry} = &apos;United States&apos;,
{!varAcctAddressCountry} = &apos;Canada&apos;,
{!varAcctAddressCountry} = &apos;Mexico&apos;
)
)</expression>
    </formulas>
    <formulas>
        <description>Displays the region of the user submitting the request. Region is sourced from the user record.</description>
        <name>frmlRegionOfCreator</name>
        <dataType>String</dataType>
        <expression>TEXT({!$User.User_Region__c})</expression>
    </formulas>
    <formulas>
        <description>Retrieve the key prefix from the ID of the record related to this sales ops request.</description>
        <name>frmlRelatedRecKeyPrefix</name>
        <dataType>String</dataType>
        <expression>LEFT( {!recordId}, 3 )</expression>
    </formulas>
    <formulas>
        <description>Link to the record from which this flow is invoked.</description>
        <name>LinkToRecord</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Enterprise_Server_URL_560}, FIND(&apos;/services&apos;, {!$Api.Enterprise_Server_URL_560}))&amp;{!recordId}</expression>
    </formulas>
