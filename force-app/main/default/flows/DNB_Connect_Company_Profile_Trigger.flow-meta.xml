<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Failed_Update_Email_Notice</name>
        <label>Failed Update Email Notice</label>
        <locationX>314</locationX>
        <locationY>995</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>esau.sanchez@ergotron.com, salesforce@ergotron.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>FLOW: Company_Record_Trigger failed.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ErrorDescription</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Execute the update of market and submarket only if the record is new or if the NAICS code changed.</description>
        <name>Entry_Condition</name>
        <label>Entry Condition</label>
        <locationX>138</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NAICS_Code_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NAICS_Changed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Market_and_Submarket_from_NAICS_code</targetReference>
            </connector>
            <label>NAICS Code changed</label>
        </rules>
    </decisions>
    <decisions>
        <description>If no NAICS mdt records were found, don&apos;t update the accounts.</description>
        <name>NAICS_mdt_Search_Result</name>
        <label>NAICS mdt Search Result</label>
        <locationX>314</locationX>
        <locationY>779</locationY>
        <defaultConnectorLabel>No NAICS mdt records found.</defaultConnectorLabel>
        <rules>
            <name>NAICS_mdt_record_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Market_and_Submarket_from_NAICS_code.Id</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Vertical_Market_and_Submarket</targetReference>
            </connector>
            <label>NAICS mdt record found.</label>
        </rules>
    </decisions>
    <description>Consult with MDM team before making changes to this flow. This trigger updates the vertical market and submarket of the related account records.</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula to determine whether the record is new.</description>
        <name>frmlNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Extract the 2 digit code from the NAICS code</description>
        <name>NAICS2Digit</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.IndustCodes_NAICS_priority1__c}, 2)</expression>
    </formulas>
    <formulas>
        <description>Formula that determines whether the NAICS code was changed.</description>
        <name>NAICS_Changed</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.IndustCodes_NAICS_priority1__c})</expression>
    </formulas>
    <interviewLabel>DNB Connect Company Profile Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DNB Connect Company Profile Trigger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the corresponding NAICS mdt record for the NAICS2Digit code. The market and submarket will be retrieved from there.</description>
        <name>Get_Market_and_Submarket_from_NAICS_code</name>
        <label>Get Market and Submarket from NAICS code</label>
        <locationX>314</locationX>
        <locationY>671</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>NAICS_mdt_Search_Result</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>NAICS2Digit</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>NAICS_Vertical_Market_Mapping__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>If a related account does not have a DHC Hospital ID, the vertical market and submarket picklists are updated based on the NAICS code of the triggering D&amp;B Company Record.</description>
        <name>Update_Vertical_Market_and_Submarket</name>
        <label>Update Vertical Market and Submarket on Related Accounts</label>
        <locationX>50</locationX>
        <locationY>887</locationY>
        <faultConnector>
            <targetReference>Failed_Update_Email_Notice</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>texcellency__DefHC_HospitalID__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Vertical_Market_Manual_Override__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Ergotron_Vertical_Market__c</field>
            <value>
                <elementReference>Get_Market_and_Submarket_from_NAICS_code.Vertical_Market__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Market_Submarket_Auto_Update_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submarket__c</field>
            <value>
                <elementReference>Get_Market_and_Submarket_from_NAICS_code.Submarket__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.DNBConnect__DBConnectAccountCompanyProfile__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Entry_Condition</targetReference>
        </connector>
        <object>DNBConnect__D_B_Connect_Company_Profile__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>One_Minute_After_Create</name>
            <connector>
                <targetReference>Get_Market_and_Submarket_from_NAICS_code</targetReference>
            </connector>
            <label>One Minute After Create</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ErrorDescription</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Flow name: Company_Record_Trigger&lt;/p&gt;&lt;p&gt;{!$Flow.CurrentDateTime}&lt;/p&gt;&lt;p&gt;Triggering Record: {!$Record.Name} - ID: {!$Record.Id}&lt;/p&gt;&lt;p&gt;Current Record: {!$Flow.CurrentRecord}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Fault Message&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
    </textTemplates>
</Flow>
