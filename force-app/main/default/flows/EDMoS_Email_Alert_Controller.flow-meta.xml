    <decisions>
        <description>outcomes depending on the customer contract status and the alert type.</description>
        <name>Customer_Alert_Type</name>
        <label>Customer/Alert Type</label>
        <locationX>467</locationX>
        <locationY>354</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Operational_Contract_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>srvcContractValidDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>case.Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Operational</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Contract_Customer_Case_Created</targetReference>
            </connector>
            <label>Operational/Contract Customer</label>
        </rules>
        <rules>
            <name>Service_Contract_Customer</name>
            <conditionLogic>1 AND (2 or 3 or 4)</conditionLogic>
            <conditions>
                <leftValueReference>srvcContractValidDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>case.Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Service</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>case.Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Warning</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>case.Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Critical</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SrvcAlert_Contract_Customer</targetReference>
            </connector>
            <label>Service/Contract Customer</label>
        </rules>
        <rules>
            <name>Service_no_contract_customer</name>
            <conditionLogic>(1 or 2) and (3 or 4 or 5)</conditionLogic>
            <conditions>
                <leftValueReference>srvcContractValidDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>srvcContractValidDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>case.Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Service</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>case.Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Warning</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>case.Alert_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Critical</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Non_Contract_Service</targetReference>
            </connector>
            <label>Service/no contract customer</label>
        </rules>
        <rules>
            <name>Operational_no_contract_customer</name>
            <conditionLogic>(1 or 2) and 3</conditionLogic>
            <conditions>
                <leftValueReference>srvcContractValidDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>srvcContractValidDate</leftValueReference>
                <operator>LessThan</operator>
