        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Includes_lines_that_require_T_E_Calculation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.T_E_Required_Count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Installed_Svcs_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_quote_as_Installed_Svcs_Required</targetReference>
            </connector>
            <label>Includes lines that require T&amp;E Calculation</label>
        </rules>
        <rules>
            <name>T_E_Required_changed_to_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.T_E_Required_Count__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Installed_Svcs_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UnFlag_quote_as_Installed_Svcs_Required</targetReference>
            </connector>
            <label>T&amp;E Required changed to 0</label>
        </rules>
    </decisions>
