<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>FindMonthName</name>
        <label>FindMonthName</label>
        <locationX>535</locationX>
        <locationY>162</locationY>
        <assignmentItems>
            <assignToReference>MonthName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CalculateMonthName_Full</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>MonthAbbreviation</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CalculateMonthName_Abbr</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Given the number for a month, return the full name and 3 character abbreviation for that month</description>
    <formulas>
        <name>CalculateMonthName_Abbr</name>
        <dataType>String</dataType>
        <expression>CASE({!MonthNumber},
1, &quot;JAN&quot;,
2, &quot;FEB&quot;,
3, &quot;MAR&quot;, 
4, &quot;APR&quot;, 
5, &quot;MAY&quot;, 
6, &quot;JUN&quot;,
7, &quot;JUL&quot;,
8, &quot;AUG&quot;,
9, &quot;SEP&quot;,
10, &quot;OCT&quot;,
11, &quot;NOV&quot;,
12, &quot;DEC&quot;,
&quot;None&quot;)</expression>
    </formulas>
    <formulas>
        <name>CalculateMonthName_Full</name>
        <dataType>String</dataType>
        <expression>CASE({!MonthNumber},
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;, 
4, &quot;April&quot;, 
5, &quot;May&quot;, 
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;)</expression>
    </formulas>
    <interviewLabel>FindMonthName {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FindMonthName</label>
    <processType>AutoLaunchedFlow</processType>
    <startElementReference>FindMonthName</startElementReference>
    <status>Active</status>
    <variables>
        <name>MonthAbbreviation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>MonthName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>MonthNumber</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
