    <description>Migrated (and updated) from the Lead-Deal Registration Default Program Type process using multiple criteria.
Trigger on Deal Registration record type only.
Checks the country of the reseller partner that created this Deal Reg to determine the program type. For Middle East countries, selects the 8% program. Otherwise, if  no program type was selected during creation, the 5% program is assigned.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_1_myRule_1_A1_9515358297</name>
        <dataType>String</dataType>
        <expression>&quot;8% Discount / 240 Days / 50,000 Minimum&quot;</expression>
    </formulas>
    <formulas>
        <description>Define the program type for MEA countries based on the country of the user that created the deal registration.
If the country is listed, the program type discount is 8%.
If the country is not listed, then the program type discount is 5%.</description>
        <name>formula_ProgramType</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.CreatedBy.Country},
&quot;Bahrain&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
&quot;Cyprus&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
&quot;Egypt&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Iraq&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Jordan&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Kuwait&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Lebanon&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Oman&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Qatar&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Saudi Arabia&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Syrian Arab Republic&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Turkey&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;United Arab Emirates&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
 &quot;Yemen&quot;,  &quot;8% Discount / 240 Days / 50,000 Minimum&quot;, 
&quot;5% Discount / 120 Days / 20,000 Minimum&quot;
)</expression>
    </formulas>
    <interviewLabel>Lead-Deal Registration Default Program Type_1 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead-Deal Registration Default Program Type_1</label>
