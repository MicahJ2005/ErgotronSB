    <decisions>
        <description>Evaluate the Lead Source Marketing field (Lead_Source__c) to determine which email alert to execute.</description>
        <name>Evaluate_Lead_Source_Marketing</name>
        <label>Evaluate Lead Source Marketing</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OEM_Medical_Web_Form</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OEM Medical Web Form</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OEM_Sales_Lead_Notification</targetReference>
            </connector>
            <label>OEM Medical Web Form</label>
        </rules>
        <rules>
            <name>JA_JP_Healthcare_Web_Inquiry_Form</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>JA-JP Healthcare Web Inquiry Form</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Japan_Healthcare_Lead_Alert</targetReference>
            </connector>
            <label>JA-JP Healthcare Web Inquiry Form</label>
        </rules>
        <rules>
            <name>ISR_Queue_Assignment</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mosaic Consultation Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lead_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mosaic SKU Finder Request Information</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lead_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Request for Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lead_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RC Request a Demo</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ISRQueue</targetReference>
            </connector>
            <label>ISR Queue Assignment</label>
        </rules>
    </decisions>
    <description>Email alerts for leads based on the Lead Source Marketing. Leads via Web-to-lead forms.</description>
    <environments>Default</environments>
    <formulas>
        <description>Link to the lead</description>
        <name>LeadLink</name>
        <dataType>String</dataType>
        <expression>HYPERLINK(&quot;/lightning/r/Lead/&quot; &amp;  {!$Record.Id} &amp; &quot;/view&quot;, &quot;View Lead&quot;, &quot;_blank&quot;)</expression>
    </formulas>
    <interviewLabel>Lead Source Marketing Email Alerts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Source Marketing Email Alerts</label>
