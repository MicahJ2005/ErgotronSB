    <decisions>
        <description>Use an exact CRM ID match. Unresolved submissions remain available for manual matching or connector follow-up.</description>
        <name>CRM_Match_Result</name>
        <label>CRM Match Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_Pending_CRM_Match</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Pending CRM Match</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Linked_Contact.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Contact_Submission</targetReference>
            </connector>
            <label>Contact Found</label>
        </rules>
        <rules>
            <name>Lead_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Linked_Lead.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Lead_Submission</targetReference>
            </connector>
            <label>Lead Found</label>
        </rules>
    </decisions>
