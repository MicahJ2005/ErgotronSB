    <decisions>
        <description>Existing = original CRM_Record_ID__c supplied. New = original CRM ID blank, even when Capture resolved a person by email. New submissions receive a Note only.</description>
        <name>Original_CRM_ID_Supplied</name>
        <label>Original CRM ID Supplied</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
