        <description>Hold unresolved submissions without making duplicate Leads or assigning a Task to an unverified person.</description>
        <name>Mark_Pending_CRM_Match</name>
        <label>Mark Pending CRM Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Ready_for_Follow_Up</targetReference>
        </connector>
        <inputAssignments>
            <field>Processing_Message__c</field>
            <value>
