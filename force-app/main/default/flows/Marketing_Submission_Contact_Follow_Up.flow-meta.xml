            <conditions>
                <leftValueReference>$Record.CRM_Record_ID__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Find_Re_Engagement_Queue</targetReference>
            </connector>
            <label>Existing - Create Task</label>
        </rules>
    </decisions>
    <decisions>
        <description>Prevent fallback assignment to the integration user if the configured Task queue is missing.</description>
        <name>Queue_Available</name>
        <label>Queue Available</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_Queue_Configuration_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Queue_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Re_Engagement_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Re_Engagement_Task</targetReference>
            </connector>
            <label>Queue Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only a verified CRM person can receive a follow-up Task.</description>
        <name>Ready_for_Follow_Up</name>
        <label>Ready for Follow Up</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Matched_Person</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>resolvedWhoId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Original_CRM_ID_Supplied</targetReference>
            </connector>
            <label>Matched Person</label>
        </rules>
    </decisions>
    <description>After-commit Marketing Submission processing. Preserve original CRM ID: supplied = Existing with queue-owned Task and Note; blank = New with Note only. Resolve person from original ID or capture lookup. Link one enhanced Note to the person and optional Task; mark Processed after success. Replaces Marketing_Submission_Process; never activate both.</description>
    <environments>Default</environments>
    <formulas>
        <description>Audit result with original submission classification, Note ID and optional Task ID.</description>
        <name>completionMessage</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.CRM_Record_ID__c}), &quot;New; Note only&quot;, &quot;Existing; Task and Note&quot;) &amp; &quot;; Note ID: &quot; &amp; {!Create_Submission_Note.Id} &amp; IF(ISBLANK({!$Record.Follow_Up_Task_ID__c}), &quot;&quot;, &quot;; Task ID: &quot; &amp; {!$Record.Follow_Up_Task_ID__c})</expression>
    </formulas>
    <formulas>
        <description>Encode the plain-text snapshot as HTML text and preserve line breaks for ContentNote. Never interpret submission details as markup.</description>
        <name>noteContentHtml</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;p&gt;&quot; &amp; SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!submissionNoteBody}, &quot;&amp;&quot;, &quot;&amp;amp;&quot;), &quot;&lt;&quot;, &quot;&amp;lt;&quot;), &quot;&gt;&quot;, &quot;&amp;gt;&quot;), MID({!lineBreakToken}, 2, 1), &quot;&lt;/p&gt;&lt;p&gt;&quot;) &amp; &quot;&lt;/p&gt;&quot;</expression>
    </formulas>
    <formulas>
        <description>Use original CRM ID when supplied; otherwise use the Contact or Lead lookup already resolved by Capture. Never overwrite original CRM_Record_ID__c.</description>
        <name>personIdForLookup</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.CRM_Record_ID__c})), TRIM({!$Record.CRM_Record_ID__c}), IF(NOT(ISBLANK({!$Record.Contact__c})), {!$Record.Contact__c}, {!$Record.Lead__c}))</expression>
    </formulas>
    <formulas>
        <description>Prefer the matched Contact or converted Contact; otherwise use the matched Lead.</description>
        <name>resolvedWhoId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Find_Linked_Contact.Id})), {!Find_Linked_Contact.Id}, IF(NOT(ISBLANK({!Find_Linked_Lead.ConvertedContactId})), {!Find_Linked_Lead.ConvertedContactId}, {!Find_Linked_Lead.Id}))</expression>
    </formulas>
    <interviewLabel>Marketing Submission - Contact Follow Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Marketing Submission - Task and Note Follow Up</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create one queue-owned follow-up Task for the resolved CRM person.</description>
        <name>Create_Re_Engagement_Task</name>
        <label>Create Re Engagement Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Mark_Routed</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Mark_Task_Creation_Failed</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Record.Submission_Details__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Find_Re_Engagement_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>$Record.Asset_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>resolvedWhoId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Create one enhanced Note preserving the marketing submission, timestamp, submitted email, and follow-up Task reference. Link this same Note to the matched CRM person and Task.</description>
        <name>Create_Submission_Note</name>
        <label>Create Submission Note</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Link_Note_to_CRM_Person</targetReference>
        </connector>
        <inputAssignments>
            <field>Content</field>
            <value>
                <elementReference>noteContentHtml</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Title</field>
            <value>
                <elementReference>$Record.Asset_Name__c</elementReference>
            </value>
        </inputAssignments>
        <object>ContentNote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Relate the enhanced submission Note to the same verified Lead or Contact as the submission. Internal visibility and viewer access.</description>
        <name>Link_Note_to_CRM_Person</name>
        <label>Link Note to CRM Person</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Follow_Up_Task_Created</targetReference>
        </connector>
        <inputAssignments>
            <field>ContentDocumentId</field>
            <value>
                <elementReference>Create_Submission_Note.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LinkedEntityId</field>
            <value>
