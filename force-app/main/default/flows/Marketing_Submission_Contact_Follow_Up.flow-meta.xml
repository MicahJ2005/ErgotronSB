    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND({!$Record.Processing_Status__c} = &quot;Received&quot;, ISBLANK({!$Record.Follow_Up_Task_ID__c}))</filterFormula>
        <object>Marketing_Submission__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Find_Linked_Lead</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <description>Plain-text marker: pipe, one newline, pipe. MID(lineBreakToken,2,1) gives a literal line-feed for HTML paragraph conversion. Keep both markers and the single newline.</description>
        <name>lineBreakToken</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>|
|</text>
    </textTemplates>
    <textTemplates>
        <description>Submission snapshot and traceability. Same enhanced Note is linked to the CRM person and, if created, the follow-up Task.</description>
        <name>submissionNoteBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Marketing Submission: {!$Record.Name}
Asset: {!$Record.Asset_Name__c}
Submitted at: {!$Record.Submitted_At__c}
Captured at: {!$Record.CreatedDate}
Submitted email: {!$Record.Submitted_Email__c}
Original CRM ID (blank = new submission): {!$Record.CRM_Record_ID__c}
Resolved CRM record: {!resolvedWhoId}
Follow-up Task ID (blank = Note only): {!$Record.Follow_Up_Task_ID__c}

Submission details:
{!$Record.Submission_Details__c}</text>
    </textTemplates>
</Flow>
