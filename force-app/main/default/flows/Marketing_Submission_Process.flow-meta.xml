<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Use an exact CRM ID match. Unresolved submissions remain available for manual matching or connector follow-up.</description>
        <name>CRM_Match_Result</name>
        <label>CRM Match Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_Pending_CRM_Match</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Pending CRM Match</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Linked_Contact.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Contact_Submission</targetReference>
            </connector>
            <label>Contact Found</label>
        </rules>
        <rules>
            <name>Lead_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Linked_Lead.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Lead_Submission</targetReference>
            </connector>
            <label>Lead Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Prevent fallback assignment to the integration user if the configured Task queue is missing.</description>
        <name>Queue_Available</name>
        <label>Queue Available</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_Queue_Configuration_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Queue_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Re_Engagement_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Re_Engagement_Task</targetReference>
            </connector>
            <label>Queue Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only a verified CRM person can receive a follow-up Task.</description>
        <name>Ready_for_Follow_Up</name>
        <label>Ready for Follow Up</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Matched_Person</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>resolvedWhoId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Find_Re_Engagement_Queue</targetReference>
            </connector>
            <label>Matched Person</label>
        </rules>
    </decisions>
    <description>After-commit Account Engagement submission processing. Links exact CRM matches, creates queue-owned follow-up Tasks, preserves capture on Task failures, and supports explicit Received-status retries.</description>
    <environments>Default</environments>
    <formulas>
        <description>Only create re-engagement Tasks when the matched Lead or Contact was created before the source submission timestamp. Missing timing requires review.</description>
        <name>confirmedExistingPerson</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.Submitted_At__c})), OR(AND(NOT(ISBLANK({!Find_Linked_Contact.Id})), {!Find_Linked_Contact.CreatedDate} &lt; {!$Record.Submitted_At__c}), AND(NOT(ISBLANK({!Find_Linked_Lead.Id})), {!Find_Linked_Lead.CreatedDate} &lt; {!$Record.Submitted_At__c})))</expression>
    </formulas>
    <formulas>
        <description>Prefer the matched Contact or converted Contact; otherwise use the matched Lead.</description>
        <name>resolvedWhoId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Find_Linked_Contact.Id})), {!Find_Linked_Contact.Id}, IF(NOT(ISBLANK({!Find_Linked_Lead.ConvertedContactId})), {!Find_Linked_Lead.ConvertedContactId}, {!Find_Linked_Lead.Id}))</expression>
    </formulas>
    <formulas>
        <description>Form identity, source time, submission reference, and preserved answers for Sales.</description>
        <name>taskContext</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;Form: &quot; &amp; {!$Record.Form_Name__c} &amp; BR() &amp; &quot;Form key: &quot; &amp; {!$Record.Form_Key__c} &amp; BR() &amp; &quot;Submission: &quot; &amp; {!$Record.Name} &amp; BR() &amp; &quot;Submitted UTC: &quot; &amp; TEXT({!$Record.Submitted_At__c}) &amp; BR() &amp; &quot;/lightning/r/Marketing_Submission__c/&quot; &amp; {!$Record.Id} &amp; &quot;/view&quot; &amp; BR() &amp; BR() &amp; {!$Record.Submission_Details__c}, 32000)</expression>
    </formulas>
    <interviewLabel>Marketing Submission - Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Marketing Submission - Process</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create one queue-owned follow-up Task for the resolved CRM person.</description>
        <name>Create_Re_Engagement_Task</name>
        <label>Create Re Engagement Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Mark_Routed</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Mark_Task_Creation_Failed</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Record.Submission_Details__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Find_Re_Engagement_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Marketing form submission - follow up</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>resolvedWhoId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Resolve the provided Salesforce Contact ID without changing its owner.</description>
        <name>Find_Linked_Contact</name>
        <label>Find Linked Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CRM_Match_Result</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_Record_ID__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Resolve the provided Salesforce Lead ID. Missing or invalid links are held for review instead of creating duplicate Leads.</description>
        <name>Find_Linked_Lead</name>
        <label>Find Linked Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Find_Linked_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_Record_ID__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Resolve queue by DeveloperName so routing works across environments without hardcoded IDs.</description>
        <name>Find_Re_Engagement_Queue</name>
        <label>Find Re Engagement Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Queue_Available</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Re_Engagement_Task_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Attach preserved submission history to the matching Contact.</description>
        <name>Link_Contact_Submission</name>
        <label>Link Contact Submission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Ready_for_Follow_Up</targetReference>
        </connector>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>Find_Linked_Contact.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Preserve the Lead relationship and converted Contact when present.</description>
        <name>Link_Lead_Submission</name>
        <label>Link Lead Submission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Ready_for_Follow_Up</targetReference>
        </connector>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>Find_Linked_Lead.ConvertedContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead__c</field>
            <value>
                <elementReference>Find_Linked_Lead.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Hold unresolved submissions without making duplicate Leads or assigning a Task to an unverified person.</description>
        <name>Mark_Pending_CRM_Match</name>
        <label>Mark Pending CRM Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Ready_for_Follow_Up</targetReference>
        </connector>
        <inputAssignments>
            <field>Processing_Message__c</field>
            <value>
                <stringValue>No exact Salesforce Lead or Contact match. Confirm connector sync and resolve CRM Record ID before retrying; do not assume this is a net-new prospect.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Processing_Status__c</field>
            <value>
                <stringValue>Pending CRM Match</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Keep intake record visible when the queue configuration is missing.</description>
        <name>Mark_Queue_Configuration_Error</name>
        <label>Mark Queue Configuration Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Processing_Message__c</field>
            <value>
                <stringValue>Required Task queue Re_Engagement_Task_Queue was not found. Correct queue configuration before retrying.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Processing_Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Store the created Task ID and mark processing complete in the same transaction as Task creation.</description>
        <name>Mark_Routed</name>
        <label>Mark Routed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Follow_Up_Task_ID__c</field>
            <value>
                <elementReference>Create_Re_Engagement_Task.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Processing_Message__c</field>
            <value>
                <stringValue>Follow-up Task assigned to Re-Engagement Task Queue. Existing Lead and Contact ownership unchanged.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Processing_Status__c</field>
            <value>
                <stringValue>Routed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Preserve the submission and flag the failed follow-up for administrator review.</description>
        <name>Mark_Task_Creation_Failed</name>
        <label>Mark Task Creation Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Processing_Message__c</field>
            <value>
                <stringValue>Task creation failed. Review the Flow error details and Task validation/automation, then retry after correcting the cause.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Processing_Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND({!$Record.Processing_Status__c} = &quot;Received&quot;, ISBLANK({!$Record.Follow_Up_Task_ID__c}))</filterFormula>
        <object>Marketing_Submission__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Find_Linked_Lead</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
