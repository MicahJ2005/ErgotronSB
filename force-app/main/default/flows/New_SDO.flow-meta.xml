    <decisions>
        <description>Evaluate the existence of opportunity partners. If any exists, proceed to delete. Otherwise, skip the delete element.</description>
        <name>Evaluate_Opportunity_Partner</name>
        <label>Evaluate Opportunity Partner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Done</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Opportunity Partners</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Partners_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Opportunity_Partners</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Opp_Partners</targetReference>
            </connector>
            <label>Opportunity Partners Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Evaluate_Sales_Model_and_Country</name>
        <label>Evaluate Sales Model and Country</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_SDO_NA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Channel_US</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Sales_Model</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Channel</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Account_Details.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_SDO_Channel_US</targetReference>
            </connector>
            <label>Channel US</label>
        </rules>
        <rules>
            <name>Bluestar_Inc_Exception</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vPrefDistiLabel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bluestar Inc</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SDO_with_Bluestar_Inc</targetReference>
            </connector>
            <label>Bluestar Inc Exception</label>
        </rules>
    </decisions>
