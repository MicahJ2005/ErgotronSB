    <formulas>
        <name>frmlDHOracleAcctId</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!chkbxGrpDistributors},&apos;D&amp;H&apos;), &apos;71346&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>frmlIMOracleAcctId</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS( {!chkbxGrpDistributors}, &apos;Ingram&apos; ),&apos;124229&apos;,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>frmlTDSOracleAcctId</name>
        <dataType>String</dataType>
        <expression>IF( CONTAINS( {!chkbxGrpDistributors}, &apos;TD&apos; ),&apos;10165&apos;,&apos;&apos;  )</expression>
    </formulas>
    <formulas>
        <name>orgUrl</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_260}))</expression>
    </formulas>
    <formulas>
        <name>sdoName</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Opportunity_Name}, {!Opportunity_Name_0})</expression>
    </formulas>
    <formulas>
        <description>captures the profile of the user to be used in a decision point later.</description>
        <name>userProfile</name>
        <dataType>String</dataType>
        <expression>{!$Profile.Name}</expression>
    </formulas>
