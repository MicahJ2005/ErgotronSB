<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Evaluate the record type of the triggering campaign to determine whether to set it or leave it and move on.</description>
        <name>Evaluate_Record_Type</name>
        <label>Evaluate Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_the_bucket_campaign</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_to_Child_Marketing_Tactic</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Child - Marketing Tactic</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Child_Record_Type_Id</targetReference>
            </connector>
            <label>Set to Child - Marketing Tactic</label>
        </rules>
    </decisions>
    <decisions>
        <description>Evaluate the Region of the campaign to determine the appropriate path.</description>
        <name>Evaluate_Region</name>
        <label>Evaluate Region</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Americas</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Americas</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Evaluate_Record_Type</targetReference>
            </connector>
            <label>Americas</label>
        </rules>
    </decisions>
    <description>Handles Salesforce Campaigns created automatically by the Oktopost Mirror Campaigns integration.  
Sets the Record Type to &quot;Child - Marketing Tactic&quot; and assigns the campaign to the predefined Oktopost Parent Campaign used for NA autogenerated social campaigns.  
Flow runs only when the campaign is created by the Oktopost integration user and meets Oktopost/NA identification criteria.  
No hierarchy automation beyond initial parent assignment is performed.</description>
    <environments>Default</environments>
    <interviewLabel>Oktopost Campaign Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Oktopost Campaign Handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the ID of the Child - Marketing Tactic campaign record type so we can assign it to the triggering record.</description>
        <name>Child_Record_Type_Id</name>
        <label>Child Record Type Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_record_Type_to_Child_Marketing_Tactic</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Child - Marketing Tactic</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the bucket campaign that will temporarily hold the Oktopost campaign. I&apos;m getting the record from cmdt to avoid a potential SOQL overuse warning in the flow.</description>
        <name>Get_the_bucket_campaign</name>
        <label>Get the bucket campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_the_Parent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BucketCampaignId</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Marketing_Setting__mdt</object>
        <sortField>Label</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Set the record type of the triggering record to Child - Marketing Tactic</description>
        <name>Set_record_Type_to_Child_Marketing_Tactic</name>
        <label>Set record Type to Child - Marketing Tactic</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_the_bucket_campaign</targetReference>
        </connector>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Child_Record_Type_Id.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Place the Oktopost campaign under the bucket campaign.</description>
        <name>Set_the_Parent</name>
        <label>Set the Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>Get_the_bucket_campaign.Salesforce_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Region</targetReference>
        </connector>
        <filterFormula>AND (
{!$Permission.Oktopost_Campaign_Creation},
ISPICKVAL({!$Record.Type}, &apos;Oktopost&apos;)
)</filterFormula>
        <object>Campaign</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
