<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Update the Owner&apos;s Manager field of the opportunity so it can be used to explicitly route approval processes to the record owner&apos;s manager instead of the previous approver manager.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Owner&apos;s Manager {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Owner&apos;s Manager</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Owner_s_Manager_Field_Update</name>
        <label>Owner&apos;s Manager Field Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Owner_s_Manager__c</field>
            <value>
                <elementReference>$Record.Owner.ManagerId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Owner_s_Manager_Field_Update</targetReference>
        </connector>
        <filterFormula>OR (
ISNEW(),
ISCHANGED({!$Record.OwnerId})
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
