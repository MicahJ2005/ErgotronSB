        <locationX>176</locationX>
        <locationY>1031</locationY>
        <connector>
            <targetReference>LATAM_False</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Sub_Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Latin America</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sub_Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Caribbean</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sub_Region__c</field>
            <operator>EqualTo</operator>
            <value>
