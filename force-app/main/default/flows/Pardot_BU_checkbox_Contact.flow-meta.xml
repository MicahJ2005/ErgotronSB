<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow checks the region box under Pardot Sync active for syncing to the correct Business Unit in Pardot, also removes the checkbox if the region changes.</description>
    <environments>Default</environments>
    <interviewLabel>Pardot BU checkbox - Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pardot BU checkbox - Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>APAC_False</name>
        <label>APAC False</label>
        <locationX>176</locationX>
        <locationY>911</locationY>
        <connector>
            <targetReference>LATAM_True</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Region__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>APAC</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>APAC_Pardot__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>If region is APAC, update the APAC checkbox for syncing to the Pardot APAC business unit.</description>
        <name>APAC_True</name>
        <label>APAC True</label>
        <locationX>176</locationX>
        <locationY>791</locationY>
        <connector>
            <targetReference>APAC_False</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>APAC</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>APAC_Pardot__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Checks the EMEA box for syncing with the EMEA Pardot Business Unit</description>
        <name>EMEA</name>
