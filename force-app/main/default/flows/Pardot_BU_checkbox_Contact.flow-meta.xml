        <filters>
            <field>Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>EMEA</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>EMEA_Pardot__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>EMEA_False</name>
        <label>EMEA False</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>US_CA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Region__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>EMEA</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>EMEA_Pardot__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>LATAM_False</name>
        <label>LATAM False</label>
        <locationX>176</locationX>
        <locationY>1151</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Sub_Region__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Latin America</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sub_Region__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Caribbean</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sub_Region__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Mexico</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>LATAM_Pardot__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
