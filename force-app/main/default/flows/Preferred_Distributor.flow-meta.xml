<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>NoChange</name>
        <choiceText>Select New</choiceText>
        <dataType>String</dataType>
        <value>
            <elementReference>NoChange</elementReference>
        </value>
    </choices>
    <decisions>
        <name>Change</name>
        <label>Change</label>
        <locationX>858</locationX>
        <locationY>52</locationY>
        <defaultConnector>
            <targetReference>Update_Distributor_ID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>NoChange</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currentDealReg.Opp_Partner_ID__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>pl_distis</elementReference>
                </rightValue>
            </conditions>
            <label>No</label>
        </rules>
    </decisions>
    <description>Filtering distributor options by country</description>
    <dynamicChoiceSets>
        <description>List of records from the Deal Reg Opp Partners custom metadata type</description>
        <name>mdt_DealRegOpptPart</name>
        <dataType>String</dataType>
        <displayField>Label</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_ISO_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>currentDealReg.CountryCode</elementReference>
            </value>
        </filters>
        <object>Deal_Reg_Opportunity_Partner__mdt</object>
        <sortField>Label</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Account_ID__c</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Preferred Distributor {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Preferred Distributor</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>To get details from the corresponding record in the Deal Reg Opp Partner metadata</description>
        <name>Deal_Reg_Opp_Partner_Detail</name>
        <label>Deal Reg Opp Partner Detail</label>
        <locationX>542</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Preferred_Distributor</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>currentDealReg.Opp_Partner_ID__c</elementReference>
            </value>
        </filters>
        <object>Deal_Reg_Opportunity_Partner__mdt</object>
        <outputAssignments>
            <assignToReference>mdtLabel</assignToReference>
            <field>Label</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Deal_Reg</name>
        <label>Get Deal Reg</label>
        <locationX>390</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Deal_Reg_Opp_Partner_Detail</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Lead</object>
        <outputReference>currentDealReg</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Opp_Partner_ID__c</queriedFields>
        <queriedFields>CountryCode</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Distributor_ID</name>
        <label>Update Distributor ID</label>
        <locationX>868</locationX>
        <locationY>218</locationY>
        <faultConnector>
            <targetReference>Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Opp_Partner_ID__c</field>
            <value>
                <elementReference>pl_distis</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <screens>
        <name>Error</name>
        <label>Error</label>
        <locationX>868</locationX>
        <locationY>433</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Fault</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;color: rgb(250, 225, 2); font-size: 20px;&quot;&gt;⚠&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;color: rgb(250, 225, 2); font-size: 20px;&quot;&gt;﻿&lt;/b&gt;Sorry! The distributor was not changed.&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;Please contact Program Management for assistance.&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;{!$Flow.FaultMessage}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Preferred_Distributor</name>
        <label>Preferred Distributor</label>
        <locationX>689</locationX>
        <locationY>50</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Change</targetReference>
        </connector>
        <fields>
            <name>currentPreferredDisti</name>
            <fieldText>&lt;p&gt;Currently selected: {!mdtLabel}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>pl_distis</name>
            <choiceReferences>NoChange</choiceReferences>
            <choiceReferences>mdt_DealRegOpptPart</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>NoChange</defaultSelectedChoiceReference>
            <fieldText>Distributors</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Deal_Reg</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>currentDealReg</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <description>Label of the record in the custom metadata type Deal Reg Opp Partner</description>
        <name>mdtLabel</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
