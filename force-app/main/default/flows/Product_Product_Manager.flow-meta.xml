<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This is the Product Manager that will approve custom product request for  a certain product line.</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula is going to select the correct Product Manager based on the Product Family.</description>
        <name>Product_Manager_Matrix</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Product_Category__c},
&apos;Arms&apos;,&apos;Tom Ditlefsen&apos;,
&apos;Wall stations&apos;,&apos;Eunjung Baek&apos;,
&apos;Mobile Workstations&apos;,&apos;Nathalie Figueroa&apos;,
&apos;Power solutions&apos;,&apos;Shylite Arias-Jones&apos;,
&apos;Device Management&apos;,&apos;Pam Indrachai&apos;,
&apos;Large format displays&apos;,&apos;Brian Tamminen&apos;, 
&apos;&apos;)</expression>
    </formulas>
    <interviewLabel>Product - Product Manager {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Product - Product Manager</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Select the user record for the correct Product Manager</description>
        <name>Product_Manager</name>
        <label>Product Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Select_Product_Manager</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Product_Manager_Matrix</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>UserType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Standard</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>This will update the approving manager field.</description>
        <name>Select_Product_Manager</name>
        <label>Select Product Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Approving_Manager__c</field>
            <value>
                <elementReference>Product_Manager.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Product_Manager</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product_Category__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Custom_Product__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
