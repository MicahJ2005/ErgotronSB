        <locationX>50</locationX>
        <locationY>575</locationY>
        <faultConnector>
            <targetReference>CC_Prod_Update_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>TruncatedProdName</elementReference>
