    <decisions>
        <name>Found_CC_Product</name>
        <label>Found CC Product</label>
        <locationX>314</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CC_Product.Id</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CC_Product_Update</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>When the Oracle Prod Name or Product Code change in the triggering product, the flow will updates the name and/or sku of the related CC Product</description>
    <environments>Default</environments>
    <formulas>
        <description>Oracle Part Name value truncated to 80 characters.</description>
        <name>TruncatedProdName</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Oracle_Part_Name__c},80)</expression>
    </formulas>
    <interviewLabel>Product Triggered Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Product Triggered Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
