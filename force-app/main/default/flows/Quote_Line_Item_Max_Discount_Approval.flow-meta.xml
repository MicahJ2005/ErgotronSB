<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Evaluates the discount applied to the quote line in relation to the max discount specified on the product.</description>
        <name>Evaluate_the_Discount_Percentage</name>
        <label>Evaluate the Discount Percentage</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Uncheck_Max_Discount_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Max_Discount_Exceeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.Maximum_Discount__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Max_Discount_Approval</targetReference>
            </connector>
            <label>Max Discount Exceeded</label>
        </rules>
    </decisions>
    <description>Enables or disables the Max Discount Approval checkbox on the quote line item based on the comparison between the discount value and the maximum discount specified on the product (Product2).</description>
    <environments>Default</environments>
    <interviewLabel>Quote Line Item Max Discount Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Item Max Discount Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Enable the &quot;Max Discount Approval&quot; checkbox</description>
        <name>Check_Max_Discount_Approval</name>
        <label>Check Max Discount Approval</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Max_Discount_Approval__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Disable the &quot;Max Discount Approval&quot; checkbox.</description>
        <name>Uncheck_Max_Discount_Approval</name>
        <label>Uncheck Max Discount Approval</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Max_Discount_Approval__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_the_Discount_Percentage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Maximum_Discount__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Maximum_Discount__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
