    <status>Active</status>
    <variables>
        <description>The renewal opportunity expected close date. This date will be used to set each task due date:
1. Initial Touchpoint — Due 180 calendar days before renewal Expected Close Date
2. Strategic Value Highlight — Due 120 calendar days before renewal Expected Close Date
3. Renewal Package — Due 90 calendar days before renewal Expected Close Date
4. Engagement Push — Due 60 calendar days before renewal Expected Close Date
5. Final Reminder — Due 30 calendar days before renewal Expected Close Date</description>
        <name>expectedCloseDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>If the original SDO has Contact Roles, the primary Contact is set on WhoId of each Task; if none, WhoId remains blank.</description>
        <name>primaryContactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Id of the renewal opportunity that launched this sub-flow. Each task created will be associated to this opportunity.</description>
        <name>renewalOpportunityId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
