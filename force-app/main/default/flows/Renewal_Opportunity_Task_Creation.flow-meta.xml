<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Creates five renewal-related Tasks for a given Opportunity, each due at fixed offsets from the Opportunity&apos;s Expected Close Date. Designed to be invoked by the Create_Renewal_Opportunity flow. Upon invocation with the Opportunity ID, Expected Close Date, Task Owner, and (optionally) Primary Contact, the subflow creates a standardized five-step renewal task cadence on the Opportunity, scheduled at 180/120/90/60/30 days prior to close.</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculates 120 days before the renewal opportunity expected close date. This is the due date of the Strategic Value Highlight task.</description>
        <name>dueDate120</name>
        <dataType>Date</dataType>
        <expression>{!expectedCloseDate} - 120</expression>
    </formulas>
    <formulas>
        <description>Calculates 180 days before the renewal opportunity expected close date. This is the due date of the Initial Touchpoint task.</description>
        <name>dueDate180</name>
        <dataType>Date</dataType>
        <expression>{!expectedCloseDate} - 180</expression>
    </formulas>
    <formulas>
        <description>Calculates 30 days before the renewal opportunity expected close date. This is the due date of the Final Reminder task.</description>
        <name>dueDate30</name>
        <dataType>Date</dataType>
        <expression>{!expectedCloseDate} - 30</expression>
    </formulas>
    <formulas>
        <description>Calculates 60 days before the renewal opportunity expected close date. This is the due date of the Engagement Push task.</description>
        <name>dueDate60</name>
        <dataType>Date</dataType>
        <expression>{!expectedCloseDate} - 60</expression>
    </formulas>
    <formulas>
        <description>Calculates 90 days before the renewal opportunity expected close date. This is the due date of the Renewal Package task.</description>
        <name>dueDate90</name>
        <dataType>Date</dataType>
        <expression>{!expectedCloseDate} - 90</expression>
    </formulas>
    <interviewLabel>Renewal Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Renewal Opportunity Task Creation</label>
    <processMetadataValues>
