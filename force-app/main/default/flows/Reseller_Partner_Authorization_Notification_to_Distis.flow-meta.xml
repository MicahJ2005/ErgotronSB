    <decisions>
        <description>Evaluate the country of the partner authorization request to determine which emails to send</description>
        <name>Partner_auth_request_evaluation</name>
        <label>Partner auth request evaluation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Internal_Ergotron_Notification</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Canadian_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Partner_Auth_Request.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_to_Ingram_Canada</targetReference>
            </connector>
            <label>Canadian Request</label>
        </rules>
    </decisions>
    <description>This flow automates email notifications to distributor partners when a user reviews and clicks a button on a reseller authorization request. Based on the partner&apos;s country, the flow determines the appropriate group of distributors to notify. If the partner is located in Canada, a specific set of Canadian distributors receives the email alerts. For all other countries, a different group of distributors is notified. Each distributor receives a separate email via predefined Salesforce email alerts.</description>
    <environments>Default</environments>
    <interviewLabel>Reseller Partner Authorization Notification to Distis {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reseller Partner Authorization Notification to Distis</label>
