    <description>Updates the Max Rebate Percent field on Pricebook Entry records based on active SPR Max Rebate Percent records. When an SPR record becomes effective, the flow sets the rebate percent for matching products in selected price books.</description>
    <environments>Default</environments>
    <interviewLabel>SPR Max Rebate Percent Sync: Update Pricebook Entries {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPR Max Rebate Percent Sync: Update Pricebook Entries</label>
    <loops>
        <description>Loop through each PBE to assig the max rebate from</description>
        <name>Loop_through_each_PBE</name>
        <label>Loop through each PBE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_PBE</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Max_Rebate_Percentages</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_PBEs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Loop through the price books to get the price book id</description>
        <name>Loop_through_Price_Books</name>
        <label>Loop through Price Books</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Price_Books</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_PB_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_PBE</targetReference>
        </noMoreValuesConnector>
    </loops>
