    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <description>Direct to the appropriate flow based on the request type selected</description>
        <name>Request_Type_Path</name>
        <label>Request Type Path</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Requests</targetReference>
            </connector>
            <label>Account</label>
        </rules>
        <rules>
            <name>Incentive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Incentive</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sales_Incentive_Inquiry</targetReference>
            </connector>
            <label>Incentive</label>
        </rules>
        <rules>
            <name>Salesforce_Issue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Issue</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Salesforce_Issue_subflow</targetReference>
            </connector>
            <label>Salesforce Issue</label>
        </rules>
        <rules>
            <name>Contact_Merge</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ContactMerge</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Contact_Merge_Flow</targetReference>
            </connector>
            <label>Contact Merge</label>
        </rules>
        <rules>
            <name>Report_Dashboard</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ReportsDashboard</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Report_Dashboard_Subflow</targetReference>
            </connector>
            <label>Report/Dashboard</label>
        </rules>
        <rules>
            <name>Campaign_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CampaignLead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Campaign_Lead_Flow</targetReference>
            </connector>
            <label>Campaign/Lead</label>
        </rules>
        <rules>
            <name>Training_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TrainingRequest</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Training_Request_flow</targetReference>
            </connector>
            <label>Training Request</label>
        </rules>
        <rules>
            <name>Sales_Tool_Seismic_etc</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Type.selectedChoiceValues</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Tool (Seismic, etc.)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Seismic_Zoom_Info_etc_flow</targetReference>
            </connector>
            <label>Sales Tool (Seismic, etc)</label>
        </rules>
    </decisions>
    <description>List of sales operations request options. This flow will launch the appropriate sub flow depending on the option selected.</description>
    <environments>Default</environments>
    <interviewLabel>Sales Ops Requests Main Menu {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sales Ops Requests Main Menu</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Main_Menu</name>
        <label>Main Menu</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Request_Type_Path</targetReference>
        </connector>
        <fields>
            <name>Request_Type</name>
            <choiceReferences>AccountRequests</choiceReferences>
            <choiceReferences>SalesIncentive</choiceReferences>
            <choiceReferences>SalesforceIssue</choiceReferences>
            <choiceReferences>ContactMerge</choiceReferences>
            <choiceReferences>ReportsDashboard</choiceReferences>
            <choiceReferences>CampaignLead</choiceReferences>
            <choiceReferences>TrainingRequest</choiceReferences>
            <choiceReferences>SalesTool</choiceReferences>
            <extensionName>flowruntime:visualPicker</extensionName>
            <fieldText>Select your request type</fieldText>
            <fieldType>ComponentChoice</fieldType>
            <inputParameters>
                <name>visualPickerSize</name>
                <value>
                    <stringValue>small</stringValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Main_Menu</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <description>Launch the Sales Ops Request flow to make an account related request</description>
        <name>Account_Requests</name>
        <label>Account Requests</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Sales_Ops_Request</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varRelatedRecordName</name>
            <value>
                <elementReference>AccountName</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Campaign_Lead_Flow</name>
