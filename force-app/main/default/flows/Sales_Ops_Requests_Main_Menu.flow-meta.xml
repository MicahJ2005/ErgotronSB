        <label>Training Request flow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Create_a_Case_Sales_Ops</flowName>
        <inputAssignments>
            <name>CaseSubject</name>
            <value>
                <stringValue>Training Request </stringValue>
            </value>
        </inputAssignments>
