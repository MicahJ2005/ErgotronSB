    <variables>
        <description>Store the Id of the account that launches the flow. This id will only be passed to the flow when invoked by a button on the account page. This Id will then be passed to the Sales Ops Request flow which follows a different path when the id is present.</description>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>The name of the account from which the flow is launched. This variable is used when the flow is launched by a button on the account page. The value is passed to the Sales Ops Request flow.</description>
        <name>AccountName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
