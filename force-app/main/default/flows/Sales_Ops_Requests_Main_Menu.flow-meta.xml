        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Create_a_Case_Sales_Ops</flowName>
        <inputAssignments>
            <name>CaseSubject</name>
            <value>
                <stringValue>Reports/Dashboard</stringValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <description>Sub flow that creates a sales incentive inquiry record and returns the Id of the record.</description>
        <name>Sales_Incentive_Inquiry</name>
        <label>Sales Incentive Inquiry</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Sales_Incentive_Inquiry</flowName>
    </subflows>
    <subflows>
        <name>Salesforce_Issue_subflow</name>
        <label>Salesforce Issue subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Create_a_Case_Sales_Ops</flowName>
        <inputAssignments>
            <name>CaseSubject</name>
            <value>
                <stringValue>Salesforce Issue</stringValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Seismic_Zoom_Info_etc_flow</name>
        <label>Seismic, Zoom Info, etc. flow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Create_a_Case_Sales_Ops</flowName>
        <inputAssignments>
            <name>CaseSubject</name>
            <value>
                <stringValue>Seismic, Zoom Info, etc.</stringValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
