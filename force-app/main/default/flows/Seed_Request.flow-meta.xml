    <description>A screen flow that creates an Internal Order type case and Seed Orders sub-type. It includes an option to request a Mosaic Cart.</description>
    <environments>Default</environments>
    <formulas>
        <description>Set the Subject for the request based on the status of the Mosaic Cart toggle  in the screen</description>
        <name>frmlSubject</name>
        <dataType>String</dataType>
        <expression>IF({!tglMosaicCartRequest.value}, &quot;Mosaic Cart Seed Request for &quot; &amp; {!Opportunity.Name} , &quot;Seed Request for &quot; &amp; {!Opportunity.Name})</expression>
    </formulas>
    <formulas>
        <description>Determines whether to includes the MosaicCartDetails template based on the Mosaic cart toggle in the screen</description>
        <name>vFrmlMosaicCartDetails</name>
        <dataType>String</dataType>
        <expression>IF({!tglMosaicCartRequest.value}, {!txtTmpltMosaicCartDetails}, null)</expression>
    </formulas>
