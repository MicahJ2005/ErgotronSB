    <decisions>
        <name>Approval_Needed</name>
        <label>Approval Needed?</label>
        <locationX>1394</locationX>
        <locationY>1119</locationY>
        <defaultConnector>
            <targetReference>Other_Condition_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Ineligible_Lines_and_Not_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>soSalesOrder.Seed_Approval_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>lstIneligibleSeedLines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Approval_Flag_to_TRUE</targetReference>
            </connector>
            <label>Ineligible Lines and Not Approved</label>
        </rules>
        <rules>
            <name>All_Eligible_and_Good_to_Go</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>soSalesOrder.Line_Count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>lstIneligibleSeedLines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>soSalesOrder.Seed_Approval_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>soSalesOrder.Seed_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Order_to_Submission_List</targetReference>
            </connector>
            <label>All Eligible and Good to Go</label>
        </rules>
    </decisions>
