<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Update partners and set the Trigger SPR Outbound checkbox to true. This checkbox will trigger the flow that sends the outbound messages -- SPR Outbound Message Trigger.</description>
        <name>Update_SPR_details</name>
        <label>Update SPR details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Opportunity.Trigger_SPR_Outbound__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Opportunity.Distributor_Party_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Disti_Account_Id.Oracle_Account_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Opportunity.Reseller_Party_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>choiceLookupReseller_Partner.selectedChoiceValues</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Opportunity.Reseller_Contact_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>choiceLookupReseller_Contact.selectedChoiceValues</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Opportunity.SF_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Opportunity.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Opportunity.Reseller_Contact_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Reseller_Contact_Email_and_Phone.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Opportunity.Reseller_Contact_Phone__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Reseller_Contact_Email_and_Phone.Phone</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <description>Check whether the Get Disti Account Id found any records in the Deal Reg partner metadata</description>
        <name>Evaluate_Disti_Account_Id</name>
        <label>Evaluate Disti Account Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Disti_Partner_Selected_is_Not_Party</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Disti_Partner_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Disti_Account_Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Reseller_Contact_Email_and_Phone</targetReference>
            </connector>
            <label>Disti Partner Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Evaluate whether the opportunity has values in the us disti partner fields via formula field.</description>
        <name>Evaluate_frmlNoUSDistiFields</name>
        <label>Evaluate frmlNoUSDistiFields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Reseller_Contact_Email_and_Phone</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>US Disti Partners Present</defaultConnectorLabel>
        <rules>
            <name>No_US_Disti_Partners_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmlNoUSDistiFields</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Disti_Account_Id</targetReference>
            </connector>
            <label>No US Disti Partners Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>evaluate_reTransmission</name>
        <label>evaluate reTransmission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Retransmit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>toggleResubmit.value</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_submission_flags_on_Opportunity</targetReference>
            </connector>
            <label>Retransmit</label>
        </rules>
    </decisions>
    <decisions>
        <description>Evaluate user profile and custom permission to determine if the user is allowed to run this flow.</description>
        <name>Evaluate_User_Profile_and_Permissions</name>
        <label>Evaluate User Profile and Permissions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Submission_not_allowed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Proceed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ergotron Program Management</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Program Management EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.Submit_SPR</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity</targetReference>
            </connector>
            <label>Proceed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Evaluate the opportunity to determine whether a submission to Oracle is allowed</description>
        <name>Submission_Allowed</name>
        <label>Submission Allowed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>scrnSPR_Submtted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Allowed</defaultConnectorLabel>
        <rules>
            <name>Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Opportunity.Trigger_SPR_Outbound__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>scrn_Type_and_Partners</targetReference>
            </connector>
            <label>Allowed</label>
        </rules>
    </decisions>
    <description>Screen flow that evaluates an opportunity to determine whether a submission to Oracle is allowed. If so, then it sets the Trigger SPR Outbound checkbox to true. This will in turn trigger flow &quot;SPR Outbound Message Trigger&quot; to send the outbound messages to Informatica.</description>
    <dynamicChoiceSets>
        <name>choiceSPRType</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>SPR_Type__c</picklistField>
        <picklistObject>Opportunity</picklistObject>
        <sortOrder>Asc</sortOrder>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>Choices to be used in screen for partner selection</description>
        <name>recChoiceSetDistiPartner</name>
        <dataType>String</dataType>
        <displayField>Name__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Partner_Role__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Distributor</stringValue>
            </value>
        </filters>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Opportunity_Partner__c</object>
        <sortField>Name__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Partner_Account__c</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>recChoiceSetResellerContact</name>
        <dataType>String</dataType>
        <displayField>Contact_Name__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>OpportunityContactRole</object>
        <outputAssignments>
            <assignToReference>vContactId</assignToReference>
            <field>ContactId</field>
        </outputAssignments>
        <sortField>Contact_Name__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Contact_Name__c</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>For selection of the reseller partners related to the opportunity</description>
        <name>recChoiceSetResellerPartner</name>
        <dataType>String</dataType>
        <displayField>Name__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Partner_Role__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Reseller</stringValue>
            </value>
        </filters>
        <object>Opportunity_Partner__c</object>
        <sortField>Name__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Oracle_Party_Id__c</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Check if any of the US disti partner fields has a value.</description>
        <name>frmlNoUSDistiFields</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISBLANK({!Opportunity.D_H_Distributing_Oracle_Account_Id__c}),
    ISBLANK({!Opportunity.Ingram_Micro_Oracle_Account_Id__c}),
    ISBLANK({!Opportunity.TD_Synnex_Oracle_Account_Id__c})
)</expression>
    </formulas>
    <interviewLabel>Submit SPR to Oracle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Submit SPR to Oracle</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Get the Oracle account id for the disti selected. The disti selected has to be a party.</description>
        <name>Get_Disti_Account_Id</name>
        <label>Get Disti Account Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Disti_Account_Id</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ChoiceLookUpDistiPartners.selectedChoiceValues</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Deal_Reg_Opportunity_Partner__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the email and phone number of the selected reseller contact to update the corresponding fields in the opportunity.</description>
        <name>Get_Reseller_Contact_Email_and_Phone</name>
