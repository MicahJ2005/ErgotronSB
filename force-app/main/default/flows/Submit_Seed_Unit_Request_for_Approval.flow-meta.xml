            <label>Americas</label>
        </rules>
    </decisions>
    <decisions>
        <description>1. If the request is submitted by a user with a [SalesRepProfile], and contains service SKU, the approval request goes to the sales rep manager and the customer care director (Unanimous Approval Required).  IF NOT...
2. If the request is submitted by a user with a [DirectorProfile],  and contains service SKU, the approval request goes to the Customer Care Director. IF NOT...
3. If the request is submitted by a user with a [SalesRepProfile], (DOES NOT contain service SKU), the approval request goes only to the manager. IF NOT...
4. The request gets Approved automatically.</description>
        <name>Request_Condition</name>
        <label>Request Condition</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Approve_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Approve the Request</defaultConnectorLabel>
        <rules>
            <name>Sales_Rep_w_Service</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Part_Num_Qty__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>srvc</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SalesRepProfile</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approver_ManagerCCD</targetReference>
            </connector>
            <label>Sales Rep w/Service</label>
        </rules>
        <rules>
            <name>Director_w_Service</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DirectorProfile</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Part_Num_Qty__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>srvc</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approver_CCD</targetReference>
            </connector>
            <label>Director w/Service</label>
        </rules>
        <rules>
            <name>Sales_Rep</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SalesRepProfile</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approver_Manager</targetReference>
            </connector>
            <label>Sales Rep</label>
        </rules>
    </decisions>
    <description>Launches approval process for seed unit request case (Internal Orders, Sub-Type: Seed Request).</description>
    <environments>Default</environments>
    <formulas>
        <description>The profile of the running user is a sales director profile</description>
        <name>DirectorProfile</name>
        <dataType>Boolean</dataType>
        <expression>OR(
{!$Profile.Name} = &apos;Ergotron Sales Director Profile&apos;,
{!$Profile.Name} = &apos;Custom Sales Director Profile&apos;,
{!$Profile.Name} = &apos;Channel Sales Director&apos;
)</expression>
    </formulas>
    <formulas>
        <description>Returns true if the profile of the running user is listed in the formula.</description>
        <name>SalesRepProfile</name>
        <dataType>Boolean</dataType>
        <expression>OR(
{!$Profile.Name} = &apos;Ergotron Sales Profile&apos;,
{!$Profile.Name} = &apos;Ergotron Inside Sales Profile&apos;
)</expression>
    </formulas>
