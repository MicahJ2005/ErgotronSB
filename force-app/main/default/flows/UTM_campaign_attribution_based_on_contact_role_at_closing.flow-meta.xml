<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Paths to decide whether to update the opportunity based on the presence of the UTM Campaign in the contact role</description>
        <name>Evaluate_UTM_Campaign_Field</name>
        <label>Evaluate UTM Campaign Field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Contact_Role_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>All_Contact_Roles</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_UTM_Campaign</targetReference>
            </connector>
            <label>Contact Role Found</label>
        </rules>
    </decisions>
    <description>When the SDO is closed, this flow evaluates all Contact Roles associated with an Opportunity and identifies the one whose Contact record has the most recently updated UTM Campaign value, determined by the UTM_Campaign_Last_Updated__c timestamp. The flow then updates the Opportunity’s UTM_Campaign__c field with the UTM Campaign value from that Contact, ensuring the Opportunity reflects the most current marketing attribution data available.</description>
    <environments>Default</environments>
    <interviewLabel>UTM campaign attribution based on contact role at closing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UTM campaign attribution based on contact role at closing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all the opportunity contact role records related to the opportunity.</description>
        <name>All_Contact_Roles</name>
        <label>All Contact Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_UTM_Campaign_Field</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UTM_Campaign__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityContactRole</object>
        <sortField>UTM_Update_Time__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Set the UTM Campaign value from the contact in the opportunity.</description>
        <name>Opportunity_UTM_Campaign</name>
        <label>Opportunity UTM Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>UTM_Campaign__c</field>
            <value>
                <elementReference>All_Contact_Roles.UTM_Campaign__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>All_Contact_Roles</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Record_Type_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Development</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
