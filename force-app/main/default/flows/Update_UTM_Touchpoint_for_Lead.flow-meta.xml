    <decisions>
        <description>Determine if it was an adwords change or utm change</description>
        <name>Did_GClID_Change_0</name>
        <label>Did GClID Change?</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Create_GCLID_Touchpoint_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>GCLID Changed</defaultConnectorLabel>
        <rules>
            <name>UTM_Values_change</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.GCLID__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.GCLID__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_UTM_Touchpoint_0_0</targetReference>
            </connector>
            <label>UTM Values change</label>
        </rules>
    </decisions>
