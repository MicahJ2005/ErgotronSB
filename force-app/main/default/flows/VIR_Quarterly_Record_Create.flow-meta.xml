    <description>Revised to adjust %&apos;s following salesforce fix of % calculations in flow.</description>
    <formulas>
        <name>CurrentMonthAmount</name>
        <dataType>Currency</dataType>
        <expression>CASE({!MonthCounter},
1, {!QuarterlyLineItem.Month_1_Net_Purchases__c},
2, {!QuarterlyLineItem.Month_2_Net_Purchases__c},
3, {!QuarterlyLineItem.Month_3_Net_Purchases__c},
0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FD_Damage_Pct</name>
        <dataType>Number</dataType>
        <expression>{!QuarterlyLineItem.FD_Damage__c} * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Financing_Pct</name>
        <dataType>Number</dataType>
        <expression>{!QuarterlyLineItem.Financing__c} * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NextMonthNumber</name>
        <dataType>Number</dataType>
        <expression>IF({!CurrentMonthNumber}+1=13, 1, {!CurrentMonthNumber}+1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Other_Pct</name>
        <dataType>Number</dataType>
        <expression>{!QuarterlyLineItem.Other_Percent__c} * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>StartMonthNumber</name>
        <dataType>Number</dataType>
        <expression>Month({!QuarterlyLineItem.Start_Date__c})-1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>VIR_Coop_Pct</name>
        <dataType>Number</dataType>
        <expression>{!QuarterlyLineItem.VIR_Coop__c} * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>WHS_FRT_Pct</name>
        <dataType>Number</dataType>
        <expression>{!QuarterlyLineItem.WHS_FRT__c} * 100</expression>
        <scale>2</scale>
    </formulas>
