<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Redirect to record detail</masterLabel>
    <description>This component redirects user to the record detail page for the provided record id</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__FlowScreen</target>
    </targets>
     <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordIDValue" label="Record Id to navigate to the detail page." type="String" />
            <property name="objectName" label="Object API Name" type="String" />
        </targetConfig>
 </targetConfigs>
</LightningComponentBundle>