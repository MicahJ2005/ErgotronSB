<script id="handlebars-relProd" type="text/x-handlebars-template">
    {{#each this}}
    <div class="col-sm-4 ">
        <div class=" cart_item-image">
            <div class="row">
                <div class="col-xs-12">
                    <div class="cc_cart_product_image relImg">
                      <a href="{{baseUrl}}{{this.External_URL__c}}" style="color: #1f3662;">
                        {{#if this.ccrz__E_ProductMedias__r.[0]}}
                            <img class="img-responsive center-block img-thumbnail" src="{{getSizeOfImage this.ccrz__E_ProductMedias__r.[0].ccrz__URI__c}}"
                            alt="{{this.Name}}" data-id=""></img>
                        {{/if}}
                        {{#if this.ccrz__AlternateName__c}}
                        <p class="item_title cc_item_title hi">
                            {{this.ccrz__AlternateName__c}}
                        </p>
                        {{else}}
                        <p class="item_title cc_item_title hi">
                            {{this.Name}}
                        </p>
                        {{/if}}
                      </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="price_block cc_price_block">
            {{#if this.ccrz__E_PriceListItems__r.[0]}}
                <p class="price cc_price">
                    <span>{{price this.ccrz__E_PriceListItems__r.[0].ccrz__Price__c}}</span>
                </p>
            {{/if}}
        </div>
        {{#if this.ccrz__SKU__c}}
        <div class="sku cc_sku hide">
            <span class="cc_label_sku">Part Number:</span>
            <span class="cc_value_sku">{{this.ccrz__SKU__c}}</span>
        </div>
        {{/if}}

        <article class="atc-btn-wrap fb-justify-content-center">
            <button class="btn btn-default btn-sm btn-base btn-gray" onclick="addToCartRelProd('{{this.ccrz__SKU__c}}');" name="" type="button" style="border-radius: 50px;">Add to Cart</button>
        </article>
    
    </div>
    {{/each}}
</script>


</apex:page>