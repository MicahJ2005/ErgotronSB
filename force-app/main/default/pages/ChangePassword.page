            <script type="text/javascript">
            
            
            function validate() {
               
                var newaaa = document.getElementById('changePassword:theForm:NewPassword').value;
                var confirmValue = document.getElementById('changePassword:theForm:ConfirmNewPassword').value;
                
                var matchesNumber = newaaa.match(/\d+/g);
                var matchesLetter = newaaa.match(/[a-zA-Z]/);
                
                 if (newaaa.length >= 8) {
                     document.getElementById("charcount").setAttribute("Style", "color: green;");
                     document.getElementById("charcounticonDis").setAttribute("Style", "display: none;");
                     document.getElementById("charcounticonEnb").setAttribute("Style", "display: inline;");
                   
                }
                else {
                     document.getElementById("charcount").setAttribute("Style", "color: #16325c;");
                    document.getElementById("charcounticonDis").setAttribute("Style", "display: inline;");
                    document.getElementById("charcounticonEnb").setAttribute("Style", "display: none;");
                }
                if (matchesNumber != null) {
                    document.getElementById("numbers").setAttribute("Style", "color: green;");
                     document.getElementById("numbersiconDis").setAttribute("Style", "display: none;");
                     document.getElementById("numbersiconEnb").setAttribute("Style", "display: inline;");
                   
                }
                else {
                     document.getElementById("numbers").setAttribute("Style", "color: #16325c;");
                    document.getElementById("numbersiconDis").setAttribute("Style", "display: inline;");
                    document.getElementById("numbersiconEnb").setAttribute("Style", "display: none;");
                }
               
                if (matchesLetter != null) {
                    document.getElementById("letters").setAttribute("Style", "color: green;");
                    document.getElementById("lettersiconDis").setAttribute("Style", "display: none;");
                    document.getElementById("lettersiconEnb").setAttribute("Style", "display: inline;");
                }
                else {
                    document.getElementById("letters").setAttribute("Style", "color: #16325c;");
                    document.getElementById("lettersiconDis").setAttribute("Style", "display: inline;");
                    document.getElementById("lettersiconEnb").setAttribute("Style", "display: none;");
                }
                    
                if(newaaa.length >= 8 && matchesLetter != null && matchesNumber != null) {
                    
                    //document.getElementById("NewPassword").setAttribute("Style", "border: 1px solid #4bca81;");
                    document.getElementById("newpasswordGood").setAttribute("Style", "color: green;display:block");
                }
                else {
                     
                    //document.getElementById("NewPassword").setAttribute("Style", "border: 1px solid #D8DDE6;");
                    document.getElementById("newpasswordGood").setAttribute("Style", "color: white;display:none");
                }
                
                 
                if(newaaa == confirmValue) {
                    
                    document.getElementById("confirmpasswordMatch").setAttribute("Style", "color: green;display:block;");
                   
                    document.getElementById("changePassword:theForm:password-buttonDis").setAttribute("Style", "color:white;display:none");
                    document.getElementById("changePassword:theForm:password-buttonEnb").setAttribute("Style", "cursor:pointer;color:black;display:block");
                }
                else {
                    //document.getElementById("ConfirmNewPassword").setAttribute("Style", "border: 1px solid #D8DDE6;");
                	document.getElementById("confirmpasswordMatch").setAttribute("Style", "color: red;display:none");
                     document.getElementById("changePassword:theForm:password-buttonDis").setAttribute("Style", "color:white;display:block;cursor:default");
                    document.getElementById("changePassword:theForm:password-buttonEnb").setAttribute("Style", "cursor:pointer;color:black;display:none");
                }
               
            }
            
            
            
            
            </script>
