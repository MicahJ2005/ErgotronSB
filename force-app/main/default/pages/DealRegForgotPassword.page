<apex:page id="ForgotPasswordPage" docType="html-5.0" controller="Deal_Reg_Forgot_Password_Cntrl" showHeader="false" sidebar="false" standardStylesheets="false">
    <apex:includeScript value="{!$Resource.jQuery211}" />
    <apex:stylesheet value="{!URLFOR($Resource.DealRegResources, 'css/main.css')}"/>

    <script type="text/javascript">    
        function validateForm() {
            var uname=document.getElementById("{!$Component.ForgotPasswordPage.mainForm.email}").value;

            //Check for entered value in email field
            if(uname.length<1 || pword.length<1) {
                alert("{!$Label.Forgot_Password_Enter_Email}");
                return false;
            }
        }
    </script>

    <head>
        <title>Ergotron Deal Registration Forgot Password</title>
        <style>
            #container {
                width: 340px;
                position: relative;
                background: none repeat scroll 0% 0% #FFF;
                border-radius: 5px;
                border: 1px solid #ccc;
                box-shadow: 0 1px 2px rgba(0, 0, 0, .1);
                margin:0 auto;
                margin-top: 200px;
                overflow: auto;
            }
        </style>
    </head> 

    <body>
        <apex:form id="mainForm" forceSSL="true">
            <div id="container">
                <div id="pageImages">
                    <apex:outputLink value="http://www.ergotron.com" id="home">
                        <apex:image styleClass="img" url="{!URLFOR($Resource.DealRegResources, 'images/ergotron-TEXT-logo.png')}" />
                    </apex:outputLink>
                </div>
                <div>
                	<apex:outputText value="{!$Label.Forgot_Password_Message}" styleClass="message" />
                </div><br/>
                <div id="email">    
                    <label for="email">{!$ObjectType.User.fields.Email.label}</label>
                    <apex:inputtext value="{!sEmail}" id="email" html-placeholder="example@example.com"/>
                </div>
                <div id="submitbtndiv" class="column1">
                    <apex:commandbutton value="{!$Label.site.submit}" action="{!forgotPassword}" id="submitbtn" onclick="return validateForm();"/>
                </div>
                <div id="divLinkRegister" class="column2">
                    <apex:outputLink value="/dealregselfreg" id="registerlink">{!$Label.Register_New_User}</apex:outputLink>
                </div>
                <div id="divLinkForgotPword" class="column2">
                    <apex:outputLink value="/dealreglogin" id="loginlink">{!$Label.site.go_to_login_page}</apex:outputLink>
                </div>
                <div id="Errors" class="message">
                    <apex:pageMessages id="pageMessages" rendered="true" /> 
                </div>
            </div>
        </apex:form>
    </body>	
</apex:page>