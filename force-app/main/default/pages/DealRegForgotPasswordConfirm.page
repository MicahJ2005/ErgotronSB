<apex:page id="ForgotPasswordConfirmPage" docType="html-5.0" showHeader="false" sidebar="false" standardStylesheets="false">
    <apex:includeScript value="{!$Resource.jQuery211}" />
    <apex:stylesheet value="{!URLFOR($Resource.DealRegResources, 'css/main.css')}"/>

    <head>
        <title>Ergotron Deal Registration Forgot Password</title>
        <style>
            #container {
                width: 340px;
                position: relative;
                background: none repeat scroll 0% 0% #FFF;
                border-radius: 5px;
                border: 1px solid #ccc;
                box-shadow: 0 1px 2px rgba(0, 0, 0, .1);
                margin:0 auto;
                margin-top: 200px;
                overflow: auto;
            }
        </style>
    </head> 

    <body>
        <apex:form id="mainForm" forceSSL="true">
            <div id="container">
                <div id="pageImages">
                    <apex:outputLink value="http://www.ergotron.com" id="home">
                        <apex:image styleClass="img" url="{!URLFOR($Resource.DealRegResources, 'images/ergotron-TEXT-logo.png')}" />
                    </apex:outputLink>
                </div>
                <apex:panelGroup >
                	<br/>
                  	<apex:outputText styleClass="message" value="{!$Label.site.temp_password_sent}"/>
                  	<br/>
                  	<br/>
                  	<apex:outputLink value="/dealreglogin" rendered="{!$Site.LoginEnabled}">{!$Label.site.go_to_login_page}</apex:outputLink>
                  	<br/>
                </apex:panelGroup>
            </div>
        </apex:form>
    </body>	
</apex:page>