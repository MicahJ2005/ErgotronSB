    function SearchForAccountAddress(addresstype) {

        //debugger;
        // get the input field value to serach for 
        var searchword = document.getElementById("accountToSearchFor").value;

        var checksearchword;

        checksearchword = searchword.trim();


        if (checksearchword && checksearchword.length > 3) {

            //return;

            // tursn on gray out 
            document.getElementById("overlay").style.display = "block";

            //  alert( 'in SearchForAccountAddress ');

            CCRZ.subsc.customActions.updatesAccountList(addresstype, searchword, function (response) {


                if (!response.success || response === undefined) {
                    alert(" Can not lookup up Accounts, contact system admin");
                }
                else {

                    // make the variable an empty array 
                    var returneddata = [];

                    returneddata = response.data;


                    var optionindex = 0;
                    var firstone = true;
                    var newoptions = '';
                    var numof = 0;

                    for (let [key, value] of Object.entries(returneddata)) {

                        numof++;
                        var thiskey = key;
                        var thisvalue = value;
                        newoptions += "<option value='" + key + "'>" + value + "</option>";
                        optionindex++;
                        firstone = false;

                        console.log(`${key}: ${value}`);
                    }


                    $("#AccountsList").html(newoptions);

                    // removes gray out        
                    document.getElementById("overlay").style.display = "none";

                    if (numof == 0) {
                        alert("No matches found, try again");

                        newoptions = "<option value='-1'>Enter text above then click Search button</option>";
                        $("#AccountsList").html(newoptions);
                    }


                }


            });

        }
        else {

            if (checksearchword) {
                alert(" You must enter at least 3 characters for a search value ");
            }
            else {
                alert(" You must enter a search for value ");
            }
        }



    }
