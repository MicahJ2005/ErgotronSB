<script type="text/javascript">
    Handlebars.registerHelper('json', function (context) {
        return JSON.stringify(context);
    });

    Handlebars.registerHelper('getSizeOfImage', function (imgString) {
        var finalImageString = '';
        if(imgString != null && imgString != '' && imgString != undefined){
            finalImageString = imgString.replace('65x65.jpg', '560x500.jpg');
        }
        return finalImageString;
    });

    Handlebars.registerHelper("changeSign", function(varName, varValue, options) {
        if(!isNaN(varValue)) {
            if(varValue < 0) {
                varValue *= -1;
            }
            options.data.root[varName] = varValue;
        } else {
            options.data.root[varName] = varValue;
        }
        
    });

    Handlebars.registerHelper("setVar", function(varName, varValue, options) {
        options.data.root[varName] = varValue;
    });

    Handlebars.registerHelper('mul', function(price, qty, options) {
        return price * qty;
    });
