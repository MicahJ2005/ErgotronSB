    </head>
    <style>
        .sendOrderToCustomer {
            display: none;
        }
        span.alert-danger{
            padding: unset;
            background-color: unset;
            border-color: unset;
        }
        .editOriginal{
            font-family: 'proxima-nova', helvetica, arial, sans-serif !important;
            display: inline-block;
            position: relative;
            padding: .556em 1.222em;
            font-size: 18px;
            line-height: 1.2;
            font-weight: normal;
            text-align: center;
            white-space: normal;
