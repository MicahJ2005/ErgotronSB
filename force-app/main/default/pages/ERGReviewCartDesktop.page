     function setShippingAddress(){
        //if($('#verify-add').modal != undefined){
            $('#verify-add').hide();
        //}
         const address1 = shippingData.delivery_line_1;
         const zipCode = shippingData.components?.zipcode;
         const plusCode = shippingData.components?.plus4_code;
         const cityName = shippingData.components?.city_name;
         const address2 = shippingData.delivery_line_2
         const stateCode = shippingData.components?.state_abbreviation;
         $('.shippingAddress1').val(address1) ;
         $('.shippingCity').val(cityName);
         if (plusCode != null) {
            const newZipCode = zipCode+'-'+plusCode;
            $('.shippingPostalCode').val(newZipCode);  
         }
         if(address2 != null){
            $('.shippingAddress2').val(address2);
         }
         if(shippingData.analysis.dpv_match_code.toLowerCase() === 's'){
            $('.shippingAddress2').val('');
         }
         if(stateCode != null){
            $('.shippingstate').val(stateCode);
         }
         
        if($("#verify-overlay").is(":visible")){
            $( "#verify-overlay" ).remove();
        }
     }
