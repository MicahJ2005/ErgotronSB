        } else {
            $('#termsAndCon').html('Digital River Inc.is the authorized reseller and merchant of the products and services offered within this store.');
            $('#trmsOfSales').html('<a href="https://store.digitalriver.com/store/defaults/en_US/DisplayDRPrivacyPolicyPage/eCommerceProvider.Digital+River%2C+Inc." target="_blank" rel="noopener noreferrer" data-auth="NotApplicable"><span style="color:#337AB7;">Privacy Policy</span></a>');
            $('#privecyPolicy').html('<a href="https://store.digitalriver.com/store/defaults/en_US/DisplayDRTermsAndConditionsPage/eCommerceProvider.Digital+River%2C+Inc." target="_blank" rel="noopener noreferrer" data-auth="NotApplicable"><span style="color:#337AB7;">Terms of Sale</span></a>');
        }
    }
    var isShowTerms = {!showTerms};
    var taxCalculationError = {!taxCalculationError};
    function enableDisableBtn() {
        if ($("#taxValueSpan").length > 0) {
            var taxHTML = $("#taxValueSpan").html();
            taxHTML = taxHTML.replace("$", "");
            productTaxValue = parseFloat(taxHTML);
        }
        if (isShowTerms) {
            if (!taxCalculationError) {
                if ($("#acceptTerms").is(':checked')) {
                    $('#acceptTermsButton').removeAttr("disabled");
                    $('#processPayments').removeAttr("disabled");
                }
                else {
                    $('#acceptTermsButton').attr('disabled', 'true');
                    $('#processPayments').attr('disabled', 'true');
                }
            }
            else {
                $('#acceptTermsButton').attr('disabled', 'true');
                $('#processPayments').attr('disabled', 'true');
                checkTaxCalculationMsg();
            }
        } else {
            if (!taxCalculationError) {
                $('#acceptTermsButton').removeAttr("disabled");
                $('#processPayments').removeAttr("disabled");
            }
            else {
                checkTaxCalculationMsg();
                $('#acceptTermsButton').attr('disabled', 'true');
                $('#processPayments').attr('disabled', 'true');
            }
        }
    }

    CCRZ.pubSub.on('view:OrderReviewView:refresh', function (userView) {
        var isCsr = CCRZ.pagevars.queryParams.portalUser;
        if (isCsr == undefined || isCsr == '')
            if (isCsr == undefined)
                $('.cc_addr_extId').hide();
                enableDisableBtn();
        let currStep  = CCRZ.cartCheckoutView.currStep;
        let step = currStep + 1;
        let title = CCRZ.cartCheckoutView.subViewArray[currStep].title
        onCheckout(title, step);
        console.log('fired Order Review');
    });

</script>

<script>         
    function proceedToPayments() {
        $("#overlayDivNew").css("display", "block");
        var cartId = CCRZ.cartCheckoutModel.attributes.sfid;
        intilizeProcessPaymentRemoting();
        CCRZ.subsc.processProcessPayments.proceedToPayment(cartId);
    }

    function intilizeProcessPaymentRemoting() {
        CCRZ.subsc = _.extend(CCRZ.subsc || {});
        CCRZ.subsc.processProcessPayments = _.extend(CCRZ.RemoteInvocation, {
            className: 'digitalriverb2b.DROrderReviewController',
            proceedToPayment: function (cartId) {
                var data = { ccCartId: cartId, sourceId: '', saveCardToWallet: false, savedCardOptionName: '', isDefaultPayment: false, paymentType: '{!JSENCODE(zeroDollarPaymentType)}' };
                this.invokeCtx('proceedToPayments', JSON.stringify(data),
                    function (result, event) {
                        if (event.status) {
                            $("#overlayDivNew").css("display", "none");
                            $("#overlayDivNew").css("display", "none");
                            if (result.error || !result.data) {
                                if (typeof CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED != 'undefined') {
                                    showMessageToast('fail', CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED);
                                } else {
                                    showMessageToast('fail', 'Failed to submit payment data to DR Server.Check Error Log Object in your org.');
                                }
                            } else if (!result.success || typeof result.data.ERROR != 'undefined' && result.data.ERROR.length > 0) {
                                if (typeof CCRZ.pagevars.pageLabels.Error_while_submitting_payments != 'undefined') {
                                    showMessageToast('fail', CCRZ.pagevars.pageLabels.Error_while_submitting_payments);
                                } else {
                                    showMessageToast('fail', 'Got error while submitting payment.');
                                }
                            } else {
                                setTimeout(function () { CCRZ.pubSub.trigger('action:processPayment', result.data['txObject']); }, 3000);
                            }
                        } else {
                            if (event.type == 'exception') {
                                if (typeof CCRZ.pagevars.pageLabels.Error_while_submitting_payments != 'undefined') {
                                    showMessageToast('fail', CCRZ.pagevars.pageLabels.Error_while_submitting_payments);
                                } else {
                                    showMessageToast('fail', 'Got error while submitting payment.');
                                }
                            }
                        }
                    },
                    {
                        buffer: false, //this call will be executed by itself
                        nmsp: false, //defines that this is a call to a subscriber class
                        timeout: 120000
                    }
                );//end invokeCtx call
            }
        });
    }

    function showMessageToast(errorType, errorMsg) {
        if ($("#messageDiv").length < 1) {
            $("#overlayDivNew").before('<div id="messageDiv" class="alert alert-success fade in alert-dismissible messageDivCss"><a href="#" class="close" data-dismiss="alert" aria-label="close" title="close">×</a><span id="messageText"></span></div>');
        }
        if (errorType == 'success') {
            $("#messageDiv").removeClass('alert-danger').addClass('alert-success');
            $("#messageText").removeClass('alert-danger').addClass('alert-success');
            $("#messageText").text(errorMsg);
            $("#messageDiv").show();
        } else {
            $("#successMsgDiv").removeClass('alert-success').addClass('alert-danger');
            $("#messageText").removeClass('alert-success').addClass('alert-danger');
            $("#messageText").text(errorMsg);
            $("#messageDiv").show();
        }
    }
</script>

</apex:page>