            $('.billingAddress1_error').html('Please enter valid billing address.');
        }
        if(!billCity || billCity.trim() === '') {
            isError = true;
            $('.billingCity_error').html('Please enter valid city.');
        }
        if(!billState || billState.trim() === '' || billState === 'AA') {
            isError = true;
            $('.billingstate_error').html('Please enter valid state.');
        }
        if(!billZip || billZip.trim() === '') {
            isError = true;
            $('.billingPostalCode_error').html('Please enter valid Zip/Postal code.');
        }


        if(!ShipFName || ShipFName?.trim() === '') {
            isError = true;
            $('.shippingfirstNameField_error').html('Please enter valid shipping first name.');
        }
        if(!ShipLName || ShipLName.trim() === '') {
            isError = true;
            $('.shippinglastNameField_error').html('Please enter valid shipping last name.');
        }
        if(!street || street?.trim() === '') {
            isError = true;
            $('.shippingAddress1_error').html('Please enter valid shipping address.');
        }
        if(!city || city.trim() === '') {
            isError = true;
            $('.shippingCity_error').html('Please enter valid shipping city.');
        }
        if(!state || state.trim() === '' || state === 'AA') {
            isError = true;
            $('.shippingstate_error').html('Please enter valid shipping state.');
        }
        if(!zipCode || zipCode.trim() === '') {
