<script id="UserInfo-AddressEdit-Desktop" type="text/template">
    <form id="{{classPrefix}}AddressForm" class="addressForm" onkeydown="return event.key != 'Enter';">
        <div class="{{classPrefix}}-messagingSection-Error" style="display: none"></div>
        <h3 class="cc_section_title">{{pageLabelMap sectionLabel}}</h3>
        {{#ifEquals classPrefix 'shipping'}}
            <!-- <a class="copyAddress cc_copy_address">{{pageLabelMap 'Checkout_UseBillingAddress'}}</a> -->
            <a class="copyAddress cc_copy_address"><i class="fa fa-pencil"></i>{{pageLabelMap 'Checkout_UseBillingAddress'}}</a>
        {{/ifEquals}}
        <p class="change_address cc_change_address">  
            <a href="#modal_{{classPrefix}}" data-toggle="modal" class="cc_change_address_modal">{{pageLabelMap 'UserInfo_AddressBook'}}</a>
        <br/>
        <div style="width:260px;" class="accountAddressSelector"> 
            <a href="#SetAccountAddress"  onclick="DisplayAccountAddressSelector('{{pageLabelMap sectionLabel}}')" style="text-decoration: none; padding-top: 0px;  padding-bottom: 0px; margin-top:0px; margin-bottom: 0px;" id="additionalInfoLink" data-toggle="modal">
                <button class="btn btn-default btn-block btn-sm " role="button">
                    SELECT DIFFERENT ACCOUNT ADDRESS
                </button>
            </a> 
            <br/>
            {{#ifEquals classPrefix 'shipping'}}
                <a href="#SetContAddress" onclick="DisplayContactSelector()" style="text-decoration: none; padding-top: 0px;  padding-bottom: 0px; margin-top:0px; margin-bottom: 0px;"  id="contcatInfoLink" data-target="#SetContAddress" data-toggle="modal">
                    <button class="btn btn-default btn-block btn-sm" role="button">
                        SELECT Contact
                    </button>
                </a> 
                <br/>
            {{/ifEquals}}
        </div>    
    </p>
    {{#ifDisplay 'SO.DsplAddrName'}}
    <div class="form-group required-field">
        <!-- <label for="firstName">{{pageLabelMap 'CheckOut_FirstName'}}</label> -->
        <input id="firstName" type="text" placeholder="{{pageLabelMap 'CheckOut_FirstName'}}" class="form-control {{classPrefix}}firstNameField {{classPrefix}}Field cc_contact_input_firstname" name="{{classPrefix}}Address.firstName" maxlength=100 value="{{this.firstName}}" />
        <!-- <span class="alert alert-danger fName_error"></span> -->
    </div>
    <div class="form-group required-field">
        <!-- <label for="lasttName">{{pageLabelMap 'CheckOut_LastName'}}</label> -->
        <input id="lastName" type="text" placeholder="{{pageLabelMap 'CheckOut_LastName'}}" class="form-control {{classPrefix}}lastNameField {{classPrefix}}Field cc_contact_input_lastname" name="{{classPrefix}}Address.lastName" maxlength=100 value="{{this.lastName}}" />
        <!-- <span class="alert alert-danger lName_error"></span> -->
    </div>
    {{/ifDisplay}}
    {{#ifDisplay 'SO.DsplAddrCompany'}}
    <div class="form-group required-field">
        <!-- <label for="companyName">{{pageLabelMap 'Profile_CompanyName'}}</label> -->
        <input id="companyName" type="text" placeholder="{{pageLabelMap 'Profile_CompanyName'}}" class="form-control {{classPrefix}}companyField {{classPrefix}}Field cc_contact_input_company" name="{{classPrefix}}Address.companyName" maxlength=100 value="{{this.companyName}}" />
        <!-- <span class="alert alert-danger primPhone_error"></span> -->
    </div>
    {{/ifDisplay}}
    <input type="hidden" class="{{classPrefix}}acctIdField {{classPrefix}}Field" name="{{classPrefix}}Address.partnerId" maxlength=100 value="{{this.partnerId}}" />
    <div class="form-group required-field">
     <!-- <label for="address1">{{pageLabelMap 'Profile_Address'}}</label> -->
     <input id="address1" type="text" placeholder="{{pageLabelMap 'Profile_Address'}}" class="form-control {{classPrefix}}Address1 {{classPrefix}}Field cc_contact_input_address" name="{{classPrefix}}Address.address1" value="{{this.address1}}" maxlength="40" />
     <input id="address2" type="text" placeholder="" class="form-control {{classPrefix}}Address2 {{classPrefix}}Field cc_contact_input_address" name="{{classPrefix}}Address.address2" value="{{this.address2}}" maxlength="40" />
     <!-- <input id="address3" type="text" class="form-control {{classPrefix}}Address3 {{classPrefix}}Field cc_contact_input_address" name="{{classPrefix}}Address.address3" value="{{this.address3}}" maxlength="40" /> -->
    </div>
    <div class="form-group">
     <!-- <label for="country">{{pageLabelMap 'CheckOut_Country'}}</label> -->
     {{{selectGeo 'country' this.countryList this.countryCode 'countryListing form-control' this.classPrefix}}}
    </div>
    <div class="form-group">
     <!-- <label for="state">{{pageLabelMap 'CheckOut_State'}}</label> -->
     <div class="stateSection cc_state_section"></div>
    </div>
    <div class="form-group required-field">
     <!-- <label for="city">{{pageLabelMap 'CheckOut_City'}}</label> -->
     <input id="city" type="text" placeholder="{{pageLabelMap 'CheckOut_City'}}" class="form-control {{classPrefix}}City {{classPrefix}}Field cc_contact_input_city" name="{{classPrefix}}Address.city" maxlength=255 value="{{this.city}}" />
    </div>
    <div class="form-group required-field">
     <!-- <label for="postalCode">{{pageLabelMap 'CheckOut_PostalCode'}}</label> -->
     <input id="postalCode" type="text" placeholder="{{pageLabelMap 'CheckOut_PostalCode'}}" class="form-control {{classPrefix}}PostalCode {{classPrefix}}Field cc_contact_input_postal_code" name="{{classPrefix}}Address.postalCode" value="{{this.postalCode}}" maxlength=10/>
    </div>
   </form>
   <div id="modal_{{classPrefix}}" class="modal fade cc_address_book_modal" tabindex="-1" role="dialog">
    <div class="modal-dialog cc_modal-dialg" role="document">
     <div class="modal-content cc_modal-content">
      <div class="modal-header cc_modal-header">
       <button type="button" class="close" data-dismiss="modal" aria-label="{{pageLabelMap 'Modal_Aria_Close'}}"><span aria-hidden="true">&#215;</span></button>
       <h4 class="modal-title cc_title">{{pageLabelMap 'UserInfo_AddressBookModal'}}</h4>
      </div>
      <div class="modal-body cc_modal-body">
       {{#each this.addressList}}
        <div class="row cc_billing_shipping_info">
         <div class="col-md-6 cc_personal_info">
          {{> addressDisplay}}
         </div>
         <div class="col-md-6 cc_select">
          <input type="button" value="{{pageLabelMap 'UserInfo_selectAddress'}}" class="btn btn-default btn-sm {{../classPrefix}}Field selectAddress cc_select_address" data-id="{{this.sfid}}"/>
         </div>
        </div>
       <hr>
       {{/each}}
      </div>
     </div>
    </div>
   </div>
   <!--  start of manual address modal div   aria-hidden="true" keep -->                        
    <div id="SetAccountAddress" class="modal fade cc_modal" tabindex="-1" role="dialog" aria-labelledby="SetAccountAddress" aria-hidden="true">
        <div class="modal-dialog cc_modal-dialog" role="document">
            <div class="modal-content cc_modal-content">
                <div class="modal-header cc_modal-header">
                        <button type="button" class="close cc_close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">X</span></button>
                        <h3 class="cc_prod_list_item_label" id="differentaddressselector"> Different Account Selector </h3>
                </div>
                <div class="modal-body cc_body">
                    <center>
                        <div id="dynamicContent2"> 
                            <br/><br/><br/><br/><br/>
                            <span style="display: inline-block; padding: 10px 0px;">Getting Accounts...</span>
                            <div style="position: fixed; left: 0; top: 0; bottom: 0; right: 0; z-index: 1001; margin: 15% 50%">
                                <div style="display: inline-block; padding: 2px; background-color: #fff;   text-align: center">
                                    <img src="/auraFW/resources/aura/images/spinner.gif" style="float: left; margin: 8px;" />
                                </div>
                            </div>
                        </div>
                    </center>
                </div>
            </div>
        </div>
    </div>
    <!-- button modle  end -->                 
    <!--contact select Modal -->
    <div id="SetContAddress" class="modal fade" role="dialog">
        <div class="modal-dialog" style="width: 53%;">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <input id="searchConts" type="text" placeholder="Search.." style="float: right;padding-right: 12rem;margin-right: 6rem;"/>
                    <h4 class="modal-title">Contacts</h4>
                </div>
                <div id="overlay-massOrder" class="modal-backdrop fade in hideDiv" style="display:none;"></div>
                <div class="modal-body">
                    <table class="table" id="contTable">
                        <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody id="contBody">
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
              
    <style>
        #overlay {
            position: fixed;
            display: none;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            z-index: 2;
            cursor: pointer;
        }          
    </style>  
</script>

<script id="Erg-Review-Desktop" type="text/template">
    <div class="panel panel-default cc_panel cc_checkout_review">
     <div class="panel-heading cc_heading hidden-print">
      <h3 class="panel-title cc_title">{{pageLabelMap 'CheckOut_GeneralInformation'}}</h3>
     </div>
     <div class="visible-print-block text-center" style="margin: 20px 20px 50px">
      <img src="https://www.ergotron.com/portals/0/ergotron-logo-blue.svg" alt="Ergotron Logo" />
      <h3 class="panel-title cc_title">Price Quote</h3>
     </div>
     <!-- <p class="hidden-print">
        <a href="javascript:window.print()">{{pageLabelMap 'OrderReview_PrintPage'}}</a>
    </p> -->
     <div class="panel-body cc_body">
      <form enctype="multipart/form-data" class="margin_form cc_OrderReview_new">
       <div class="messagingSection-Error" style="display: none"></div>
       <div class="messagingSection-Info" style="display: none"></div>
       <div class="messagingSection-Warning" style="display: none"></div>
       <!-- <div class="well cc_well cc_order_review">
        <div class="row">
         <div class="col-xs-12 col-md-4">
          <h5 class="cc_buyer_information">{{pageLabelMap 'CheckOut_BuyerInformation'}}</h5>
          <p class="cc_buyer">
            {{#showOrderReviewdit}}    
           <a id="edit_UserInfo" href="#edit_UserInfo" class="editAddressInfo cc_edit_address_info">{{pageLabelMap 'CheckOut_edit'}}</a><br>
           {{/showOrderReviewdit}}
           
           <div class="cc_buyer_firstname">{{this.buyerFirstName}} {{this.buyerLastName}}</div>
           <div class="cc_buyer_phone">{{this.buyerPhone}}</div>
           <div class="cc_buyer_email">{{this.buyerEmail}}</div>
          </p>
          {{#isErgotronStoreCart}}
          {{else}}
          <h5 class="cc_shipping_information">{{pageLabelMap 'CheckOut_ShipmentInformation'}}</h5>
          <p class="cc_shipping">
            {{#showOrderReviewdit}}   
                <a id="edit_Shipping" href="#edit_Shipping" class="editShippingInfo cc_edit_shipping_info">{{pageLabelMap 'CheckOut_edit'}}</a><br>
           {{/showOrderReviewdit}}
           {{/isErgotronStoreCart}}
           {{#if this.shippingMethod}}
            <p class="cc_shipping_method_section">
             <span class="cc_shipping_method_label">{{pageLabelMap 'CheckOut_ShippingMethod'}}&#58;&#160;</span>
             <span class="cc_shipping_method">{{this.shippingMethod}}</span>
            </p>
           {{/if}}
           {{#if this.shippingInst}}
            <p class="cc_shipping_notes_section">
             <span class="cc_shipping_notes_label">{{pageLabelMap 'CheckOut_ShippingNotes'}}&#58;&#160;</span>
             <span class="cc_shipping_notes">{{this.shippingInst}}</span>
            </p>
           {{/if}}
           {{#if this.requestedDateStr}}
            <p class="cc_shipping_delivery_section">
             <span class="cc_shipping_delivery_date_label">{{pageLabelMap 'Checkout_RequestedDeliveryDt'}}&#58;&#160;</span>
             <span class="cc_shipping_delivery_date">{{this.requestedDateStr}}</span>
            </p>
           {{/if}}
          </p>
         </div>
         <div class="col-xs-12 col-md-4">
          <h5 class="cc_billing_address_label">{{pageLabelMap 'CheckOut_BillingAddress'}}</h5>
          {{#showOrderReviewdit}}
          <a id="edit_UserInfo" href="#edit_UserInfo" class="editAddressInfo cc_edit_address_info">{{pageLabelMap 'CheckOut_edit'}}</a><br>
          {{/showOrderReviewdit}}
          <span class="cc_billing_address">{{> addressDisplay this.billingAddress}}</span>
         </div>
         <div class="col-xs-12 col-md-4">
          {{#if this.hasCoupon}}
