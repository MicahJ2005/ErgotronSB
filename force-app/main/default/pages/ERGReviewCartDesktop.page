            $('.billingfirstNameField_error').html('Please enter valid billing first name.');
        }
        if(!billLName || billLName.trim() === '') {
            isError = true;
            $('.billinglastNameField_error').html('Please enter valid billing last name.');
        }
        if(!billStreet || billStreet?.trim() === '') {
