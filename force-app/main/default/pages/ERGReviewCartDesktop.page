            isError = true;
            $('.email_error').html('Please enter valid email.');
        }
        if(!confEmail || confEmail.trim() === '') {
            isError = true;
            $('.email_conf_error').html('Please enter valid email.');
        }
        if((confEmail || confEmail.trim() != '') && confEmail.trim() != email.trim()) {
            isError = true;
            $('.email_conf_error').html('Email Address does not match');
