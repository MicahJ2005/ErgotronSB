            function callSubmitPayPalPayment(sourceId,saveCardToWallet,savedCardOptionName) {
                saveCardToWallet=$("#rememberMePaypal").is(':checked');
                savedCardOptionName =$("#nickNamePaypal").val();
                
                var cartId = CCRZ.cartCheckoutModel.attributes.sfid;
                intilizePayPalPaymentRemoting();
                CCRZ.subsc.processPayPalPayments.submitPayPalPayment(cartId, sourceId,saveCardToWallet,savedCardOptionName,false,'paypal');
                
                
            }
            
            function intilizePayPalPaymentRemoting(){
                CCRZ.subsc = _.extend(CCRZ.subsc||{});
                    CCRZ.subsc.processPayPalPayments= _.extend(CCRZ.RemoteInvocation,{
                        className : 'digitalriverb2b.DRB2B_PaymentController',
                        submitPayPalPayment: function(cartId, sourceId,saveCardToWallet,savedCardOptionName,isDefaultPayment,paymentType) {
                            var data = {ccCartId : cartId,sourceId : sourceId,saveCardToWallet : saveCardToWallet,savedCardOptionName : savedCardOptionName,isDefaultPayment : isDefaultPayment,paymentType : paymentType };
                            this.invokeCtx('submitPayments', JSON.stringify(data), 
                                function(result, event) {
                                    if(event.status) {
                                       // debugger;
                                        if(result.error || !result.data) {
                                            if(typeof  CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED != 'undefined'){
                                                showMsgToast('fail', CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED);
                                            }else{
                                                showMsgToast('fail', 'DR_SERVER_PAYMENT_FAILED');
                                            }                                            
                                            $("#mainPayPalDiv").empty();
                                            $("#mainPayPalDiv").append('<div id="paypal-button"></div><div id="savePaypalDiv"  style="display:none;"><input id="rememberMePaypal"  type="checkbox"  onchange="paypalCheckboxChanged()"/>&nbsp;<b> Save Payment</b><br/><input type="text" onKeyUp="checkNickName()" id="nickNamePaypal" placeholder ="Enter NickName" style="display:none;width:13%;padding: 6px 11px; margin: 8px 0; box-sizing: border-box;"/></div>');
                                            $("#overlayDivNew").hide();
                                            handlePayPalClickAndReload();
                                        }
                                        else if(result.success) {
                                            if(typeof  CCRZ.pagevars.pageLabels.DR_PAYPAL_AUTHORIZED != 'undefined'){
                                                showMsgToast('success', CCRZ.pagevars.pageLabels.DR_PAYPAL_AUTHORIZED);
                                            }else{
                                                showMsgToast('success', 'DR_PAYPAL_AUTHORIZED');
                                            }
                                            if($("#rememberMe").is(':checked')) {
                                                try {
                                                    result.data.txObject.accountNumber=result.data.txObject.accountNumber+'--%&*$@--'+result.data.savedCardNickName;
                                                }catch(e){
                                                }
                                            }
                                            result.data['txObject'].accountType = 'pp';
                                            setTimeout(function(){ CCRZ.pubSub.trigger('action:processPayment', result.data['txObject']); }, 3000);
                                        }else{
                                            if(typeof  CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED != 'undefined'){
                                                showMsgToast('fail', CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED);
                                            }else{
                                                showMsgToast('fail', 'DR_SERVER_PAYMENT_FAILED');
                                            }
                                            $("#overlayDivNew").hide();
                                            $("#mainPayPalDiv").empty();
                                            $("#mainPayPalDiv").append('<div id="paypal-button"></div><div id="savePaypalDiv"  style="display:none;"><input id="rememberMePaypal"  type="checkbox"  onchange="paypalCheckboxChanged()"/>&nbsp;<b> Save Payment</b><br/><input type="text" onKeyUp="checkNickName()" id="nickNamePaypal" placeholder ="Enter NickName" style="display:none;width:13%;padding: 6px 11px; margin: 8px 0; box-sizing: border-box;"/></div>');
                                            handlePayPalClickAndReload();
                                        }
                                    }
                                    else if(event.type ='exception' && typeof event.message != undefined && event.message !=  null  && event.message != '') {
                                        $("#mainPayPalDiv").empty();
                                        $("#mainPayPalDiv").append('<div id="paypal-button"></div><div id="savePaypalDiv"  style="display:none;"><input id="rememberMePaypal"  type="checkbox"  onchange="paypalCheckboxChanged()"/>&nbsp;<b> Save Payment</b><br/><input type="text" onKeyUp="checkNickName()" id="nickNamePaypal" placeholder ="Enter NickName" style="display:none;width:13%;padding: 6px 11px; margin: 8px 0; box-sizing: border-box;"/></div>');
                                        showMsgToast('fail', event.message);
                                        $("#tryAgainButton").show();
                                    }
                                    else {
                                        if(typeof  CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED != 'undefined'){
                                            showMsgToast('fail', CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED);
                                        }else{
                                            showMsgToast('fail', 'DR_SERVER_PAYMENT_FAILED');
                                        }
                                        $("#mainPayPalDiv").empty();
                                        $("#mainPayPalDiv").append('<div id="paypal-button"></div><div id="savePaypalDiv"  style="display:none;"><input id="rememberMePaypal"  type="checkbox"  onchange="paypalCheckboxChanged()"/>&nbsp;<b> Save Payment</b><br/><input type="text" onKeyUp="checkNickName()" id="nickNamePaypal" placeholder ="Enter NickName" style="display:none;width:13%;padding: 6px 11px; margin: 8px 0; box-sizing: border-box;"/></div>');
                                        handlePayPalClickAndReload();
                                    }
                                },
                                {
                                    buffer:false, //this call will be executed by itself
                                    nmsp : false, //defines that this is a call to a subscriber class
                                    timeout: 120000
                                }
                            );//end invokeCtx call
                        }
                    });
                }
            function checkNickName (){
                
                if($("#rememberMePaypal").is(':checked') && (typeof $("#nickNamePaypal").val() != 'undefined' &&  $("#nickNamePaypal").val() != '')){
                    paypalActions.enable();
                }else{
                    paypalActions.disable();
                }
                if(!isPaypalSubscriptionPresent && !($("#rememberMePaypal").is(':checked')) && (typeof $("#nickNamePaypal").val() == 'undefined' ||  $("#nickNamePaypal").val() == ''))
                    paypalActions.enable();
            }
           
        </script>
