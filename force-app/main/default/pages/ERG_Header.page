            </apex:variable>

            <apex:variable var="v" value="1" rendered="{!link.DeveloperName == 'SEARCH'}">
                <a data-url="{!link.Link__c}" class="search" id="topHeaderLinkSearch">
                </a>
            </apex:variable>
        </apex:repeat>
    </div>

