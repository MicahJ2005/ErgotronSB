    <script>
        const isExternalCart = JSON.parse('{!isExternalCart}');
        console.log(isExternalCart);
        function logOut(){
            $('.doLogout.cc_do_logout').click();
        }
        function setCompanyName() {
            const company = $('.cc_companyname').val();
            const fName = $('.cc_firstname').val();
            const lname = $('.cc_lastname').val();
            $('.cc_companyname').val(`${fName} ${lname}`);
        }
        function validate(isBlur) {
            $('#user-reg-error').html('');
            $('.cc_newpassword').nextAll().remove();
            $('.cc_newpassword').parent().removeClass('has-error has-success');
            $('.cc_confirmpassword').nextAll().remove();
            $('.cc_confirmpassword').parent().removeClass('has-error has-success');
            $('.cc_confirmusername').nextAll().remove();
            $('.cc_confirmusername').parent().removeClass('has-error has-success');

            let isAlterError = false;
            const company = $('.cc_companyname').val();
            const fName = $('.cc_firstname').val();
            const lname = $('.cc_lastname').val();
            const phone = $('.cc_phone').val();
            const username = $('.cc_username').val();
            const confirmusername = $('.cc_confirmusername').val();
            const pass = $('.cc_newpassword').val();
            const confirmPass = $('.cc_confirmpassword').val();
            const cAdd = $('.cc_checkoutaddress').val();
            const cCity = $('.cc_checkoutcity').val();
            const cPostalCode = $('.cc_checkoutpostalcode').val();
            const sAdd = $('.cc_shippingaddress1').val();
            const sCity = $('.cc_shippingcity').val();
            const sPostalCode = $('.cc_shippingpostalcode').val();
            const billState = $('.billingstate').val();
            const shipState = $('.shippingstate').val();

            if(fName.trim() === '' || lname.trim() === '' || phone.trim() === '' 
            || username.trim() === '' || cAdd.trim() === '' || cCity.trim() === '' 
            || cPostalCode.trim() === '' || sAdd.trim() === '' || sCity.trim() === ''
            || sPostalCode.trim() === '' || billState.trim() === '' || billState.trim() === 'AA' 
            || shipState.trim() === '' || shipState.trim() === 'AA' || confirmusername.trim() === '') {
                isAlterError = true;
            }

            if(shipState.trim() === '' || shipState.trim() === 'AA'){
                $('#shipState-error').show();
                $('.shipStateErr').addClass('has-error');
            } else{
                $('#shipState-error').hide();
                $('.shipStateErr').removeClass('has-error');
            }

            if(billState.trim() === '' || billState.trim() === 'AA'){
                $('#billState-error').show();
                $('.billStateErr').addClass('has-error');
            } else{
                $('#billState-error').hide();
                $('.billStateErr').removeClass('has-error');
            }

            let isError = false;
            let isUserNameErr = false;
            let errConfirmuserName = '<span id="ConfirmUserName-error" style="font-style: italic;" class="error help-block">';
            if(username && confirmusername && confirmusername === username){  
            $('.cc_confirmusername').parent().addClass('has-success');
            } else{
                if(confirmusername == "" || confirmusername !== username) {
                    isUserNameErr = true;
                }
            }

            let errPass = '<span id="NewPassword-error" style="font-style: italic;" class="error help-block">';
            let errConfirmPas = '<span id="ConfirmPassword-error" style="font-style: italic;" class="error help-block">';
            //let isError = false;
            const passRegex = /^(?=.*[0-9])(?=.*[a-z]).{8,20}$/gm;
            if(pass != "" && passRegex.test(pass)){
                $('.cc_newpassword').parent().addClass('has-success');
            } else{
                if(pass) {
                    isError = true;
                }
            }
            if(pass && confirmPass && confirmPass === pass){  
                $('.cc_confirmpassword').parent().addClass('has-success');
            } else{
                if(confirmPass) {
