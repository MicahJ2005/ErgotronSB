    <style>
    .ergomods #MyAccount_navSection .panel.cc_myaccount_nav{
        background-color: unset !important;
        border: none !important;
    }
    .ergomods #MyAccount_navSection .panel.cc_myaccount_nav ul.side_navigation_dropdown{
        border: 1px solid #ccc;
        background-color: #f5f5f5;
    }

    .ergomods #newCustomerForm .btn-default.cc_another_submit{
        font-family: 'proxima-nova', helvetica, arial, sans-serif !important;
        display: inline-block;
        position: relative;
        padding: .556em 1.222em;
        font-size: 18px;
        line-height: 1.2;
        font-weight: normal;
        text-align: center;
        white-space: normal;
        text-transform: none;
        border: 0;
        border-radius: 50px;
        z-index: 1;
        cursor: pointer;
        width: auto;
        margin-top: 64px;
    }

    @media (min-width:450px) {
        .ergomods #newCustomerForm .btn-default.cc_another_submit {
            width: 200px
        }
    }

    .ergomods #newCustomerForm .btn-default.cc_another_submit:after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        border-radius: 50px;
        transition: all .4s;
        z-index: -1
    }
    .ergomods #newCustomerForm .btn-default.cc_another_submit:focus, 
    .ergomods #newCustomerForm .btn-default.cc_another_submit:hover {
        text-decoration: none;
        background-color: #fff;
        border: solid 1px #1F3662;
    }

    #overlayRelProd{
        position: fixed; 
        display: none; 
        width: 100%; 
        height: 100%; 
        top: 0; 
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.5); 
        z-index: 2; 
        cursor: pointer; 
    }

    @media (max-width: 358px) {
      .ergomods .signup-section { display: none; }
    }

    .order_confirmation_subsBox{
        max-width: 24em;
        margin: 0 auto 3rem;
        background: #00264f;
        padding: 15px 15px 15px 15px;
        border-radius: 5px;
    }

    .cc_order_confirmation_subsText{
        color: #fff;
        font-size: 1.6rem;
        margin-bottom: 0;
        margin-left: 3rem;
    }

    .subBtn{
        margin-left: 11%;
        border-radius: 3rem !important;
        color: #000;
        font-size: 1.5rem !important;
        text-transform: capitalize !important;
    }

    .signup-text{
        max-width: 400px;
        margin: 3rem auto auto;
        padding: 15px 15px;
        border-radius: 3px;
    }

    .signup-text p {
      text-align: center;
      font-size: 17px !important;
    }

    </style>

