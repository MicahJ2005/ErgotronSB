    <div id="topHeaderLinks" class="top-link hidden">
        <apex:repeat value="{!topHeaderLinks}" var="link">
            
            <apex:variable var="v" value="1" rendered="{!link.DeveloperName == 'RESELLERS'}">
                <!-- <a href="{!link.Link__c}" class="resellers" id="resellers">
                    <i class="icon icon-pin"></i>
                    <span class="text">{!link.label}</span>
                </a> -->
                <li id="resellers" style="display: none">
                    <a class="resellers where-btn" href="{!link.Link__c}">
                        <i class="icon icon-pin"></i>
                        <span class="text">{!link.label}</span>
                    </a>
                </li>
            </apex:variable>
            <apex:variable var="v" value="1" rendered="{!link.DeveloperName == 'MY_LIST'}">
                <!-- <a href="{!link.Link__c}" class="my-list" id="my-list">
                    <i class="icon icon-ribbon"></i>
                    <span class="text">{!link.label}</span>
                </a> -->
