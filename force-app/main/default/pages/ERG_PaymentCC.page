<apex:page applyBodyTag="false" applyHtmlTag="false" docType="html-5.0" sidebar="false" showHeader="false" standardStylesheets="false"
           controller="digitalriverb2b.DRB2B_PaymentController" >
    <style>
        .field {
            //background-color: #ccc;
            padding: 20px 10px;
            border-radius: 4px;
            border: 1px solid transparent;
            box-shadow: 0 1px 3px 0 #76b900;
            -webkit-transition: box-shadow 150ms ease;
            transition: box-shadow 150ms ease;
        }
        .invalid {
            border: 1px solid red;
            background-color: #ff9999;
        }
        .empty {
            border: 1px solid blue;
        }
        .focus {
            border: 1px solid orange;
        }
        .complete {
            border: 1px solid green;
            background-color: #c6efce;
        }
        .DRGooglePayElement {
            width: 100%;
            margin-bottom: 10px;
        }
        .DRApplePayElement {
            width: 100%;
            margin-bottom: 10px;
        }
        .payment-button {
            margin: 15px 0px;
            height: 45px;
            overflow: hidden;
        }
        .submitForm{
            padding: 9px 17px 7px !important;
            font-size: 11px !important;
        }
        .ccrow{
            width : 100%;
        }
        .row-column{
            width: 31%;
            margin: 5px;
        }
        .ccrow .field{
            padding: 5px 10px;
        }
        .row-column40{width:22%;    margin: 5px;}
        .row-column50{width:54%;}
        .placeHolderText{font-size: 13px !important;font-family: Arial, Helvetica, sans-serif;}
    </style>
