                                <!--<a id="displayCertificateLink" href="#" onclick="openTaxExemptModal(); return false;" style="display:none;">Click here If you are making a tax exempt purchase</a>-->
                                <div class="row">
                                  <div class="col-xs-6">
                                    <p class="link_button cc_link_button">
                                      <input class="button processBack btn btn-default btn-sm btn-base btn-gray cc_process_back" type="button" value="Go Back" alt="Back">
                                    </p>
