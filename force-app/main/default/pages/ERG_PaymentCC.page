                    </script>
                    <script>
                        var isSubscriptionProductPresent =false;
                        var isCardnumberComplete = false;
                        var isCardExpiration = false;
                        var isCardCvv = false;
                        var isSubmitClicked = true;
                        $( document ).ready(function() {                            
                            for(i=0;i<CCRZ.cartCheckoutModel.attributes.cartItems.length;i++){
                                if('installmentFrequency' in CCRZ.cartCheckoutModel.attributes.cartItems[i] || 'orderFrequency' in CCRZ.cartCheckoutModel.attributes.cartItems[i] || 'ignoreInstallmentFrequencyFields' in CCRZ.cartCheckoutModel.attributes.cartItems[i]){
                                    isSubscriptionProductPresent = true;
                                }
                            }
                        });
                        Handlebars.registerHelper("displayCertificateLinkHelper", function(data) {
                            if({!isDisplayUploadTaxCertificateLink}){
                                if(CCRZ.currentUser.UserType == 'Guest'){
                                    var pageLabelValue = 'Guest_User_profile';
                                    if(typeof CCRZ.pagevars.pageLabels.Guest_User_profile !== 'undefined' && CCRZ.pagevars.pageLabels.Guest_User_profile !== null && CCRZ.pagevars.pageLabels.Guest_User_profile !== '' ){
                                        pageLabelValue = CCRZ.pagevars.pageLabels.Guest_User_profile;
                                    }
                                    return new Handlebars.SafeString(' '+pageLabelValue);
                                }else{
                                    var pageLabelValue = 'Display_Certificate_Link_CC';
                                    if(typeof CCRZ.pagevars.pageLabels.Display_Certificate_Link_CC !== 'undefined' && CCRZ.pagevars.pageLabels.Display_Certificate_Link_CC !== null && CCRZ.pagevars.pageLabels.Display_Certificate_Link_CC !== '' ){
                                        pageLabelValue = CCRZ.pagevars.pageLabels.Display_Certificate_Link_CC;
                                    }
                                    return new Handlebars.SafeString('<a id="displayCertificateLink" href="#" onclick="openTaxExemptModal(); return false;">'+pageLabelValue+'</a>');
                                }
                            }else{
                                if(CCRZ.currentUser.UserType == 'Guest'){
                                    var pageLabelValue = 'Guest_User_profile';
                                    if(typeof CCRZ.pagevars.pageLabels.Guest_User_profile !== 'undefined' && CCRZ.pagevars.pageLabels.Guest_User_profile !== null && CCRZ.pagevars.pageLabels.Guest_User_profile !== '' ){
                                        pageLabelValue = CCRZ.pagevars.pageLabels.Guest_User_profile;
                                    }
                                    return new Handlebars.SafeString(' '+pageLabelValue);
                                }else{
                                    return '';
                                }
                                
                            }
          
                        });
                        jQuery(function($) {
                            $("#overlayDivNew").css("display", "block");
                            var sourceId;
                            CCRZ.models.PaymentsCCModel = CCRZ.CloudCrazeModel.extend(); 
                            // debugger;
                            CCRZ.views.PaymentsCCView = CCRZ.CloudCrazeView.extend({ 
                                viewName : "PaymentsCCView",
                                managedSubView : true,
                                templateDesktop : CCRZ.util.template("PaymentCC-Both"), 
                                templatePhone : CCRZ.util.template("PaymentCC-Both"), 
                                init : function(options)
                                {
                                    this.selector = options.selector;
                                    this.render();
                                    CCRZ.pubSub.trigger('action:paymentViewInit',this);
                                    //debugger;
                                },
                                events:  
                                {
                                    
                                },
                                validateInfo: function(formName, fieldData)
                                {
                                    
                                },
                                
                                parentPreRender : function()
                                {
                                    //Look for the instantiated iframe
                                    //Detach it from the DOM
                                    //Re-render the view but dont create the iframe
                                    //Re-attach the iframe as appropriate in the rendered view
                                },
                                renderDesktop : function()
                                {
                                    this.setElement(this.selector);
                                    this.data={};
                                    this.$el.html(this.templateDesktop(this.data));
                                    //setTimeout(renderDRIframe,10000);
                                    //renderDRIframe();                                    
                                },
                                renderPhone : function()
                                {
                                    this.setElement(this.selector);
                                    this.data={};
                                    this.$el.html(this.templatePhone(this.data));
                                    //setTimeout(renderDRIframe,10000);
                                    //renderDRIframe();
                                },
                            });
                            CCRZ.pubSub.trigger('action:paymentViewReady','cc',function(options) {
                                CCRZ.payment = CCRZ.payment||{views:{}};
                                CCRZ.payment.views.pod = new CCRZ.views.PaymentsCCView({
                                    model : new CCRZ.models.PaymentsCCModel(),
                                    selector : options.selector
                                });
                                setTimeout(renderDRIframe,'{!HTMLENCODE(renderTime)}');
                                $('#submitCCPayment').attr('disabled','true');                                                               
                            });
                            //call after page loaded
                            CCRZ.pubSub.on('view:PaymentsCCView:refresh', function() {
                                setTimeout(renderDRIframe,'{!HTMLENCODE(renderTime)}');
                                $('#submitCCPayment').attr('disabled','true');                                
                                
                            });
                        });
                        function unescapedHtml(){
                            return $("<span />", { html: arguments[0] }).text();
                        }
                        function renderDRIframe() {
                            var digitalriverjs = new DigitalRiver('{!JSENCODE(apiKeygetter)}');
                            var style = {
                                classes: {
                                    base: "DRElement",
                                    complete: "complete",
                                    empty: "empty",
                                    focus: "focus",
                                    invalid: "invalid",
                                    webkitAutofill: "autofill"
                                },
                                style: {
                                    base: {
                                        color: "#000",
                                        fontFamily: "proxima-nova, Arial, Helvetica, sans-serif",
                                        fontSize: "16px",
                                        margin: "20px"
                                        // '::-webkit-input-placeholder': {
                                        //   color: red
                                        // },
                                        // '::placeholder': {
                                        //   color: red
                                        // } 
                                    }
                                },
                                complete: {
                                    color: "#99ffff !important",                            
                                    
                                },
                                invalid: {
                                    color: "#ff9999 !important",
                                    
                                }
                            }
                            //var cardNumber = digitalriverjs.createElement('cardnumber', style);
                            var cardNumber = digitalriverjs.createElement('cardnumber', Object.assign({},style, {placeholderText: ''}));
                            //Place the Card Number element within the container created above.
                            cardNumber.mount('card-number');
                            //Create your Card Expiration element
                            var cardExpiration = digitalriverjs.createElement('cardexpiration', Object.assign({},style, {placeholderText: 'MM/YY'}));
                            //Place the Card Expiration element within the container created above.
                            cardExpiration.mount('card-expiration');
                            //cardExpiration.mount('card-expiration',cardExpiration);
                            //Create your Card Security Code element
                            var cardSecurityCode = digitalriverjs.createElement('cardcvv', Object.assign({},style, {placeholderText: ''}));
                            //Place the Card Security Code element within the container created above.
                            cardSecurityCode.mount('cardcvv');
                            
                            cardNumber.on('change', function(event) {             
                                const cardImgUrl = "{!URLFOR($Resource.CCErgotronTheme, 'images/cards')}";

                                if(event?.brand?.toLowerCase() !== 'unknown') {
                                    $('.ccrow.card-img #card-image').attr('src', `${cardImgUrl}/credit-cards-${event?.brand}.png`);
                                    console.log('find img');
                                } else {
                                    $('.ccrow.card-img #card-image').attr('src', `${cardImgUrl}/credit-cards.png`);
                                }
                                      
                                isCardnumberComplete = event.complete;
                                changeSubmitBtn(isCardnumberComplete,isCardExpiration,isCardCvv);
                            });
                            cardExpiration.on('change', function(event) {
                                isCardExpiration = event.complete;
                                changeSubmitBtn(isCardnumberComplete,isCardExpiration,isCardCvv);
                            });
                            cardSecurityCode.on('change', function(event) {
                                isCardCvv = event.complete;
                                changeSubmitBtn(isCardnumberComplete,isCardExpiration,isCardCvv);
                            });
                              if(CCRZ.currentUser.UserType == 'Guest'){
                                    $('#savecardRow').hide();
                                }
                            // Create a token or display an error when the form is submitted.
                            var paymentForm = document.getElementById('payment-form');
                            //debugger;
                            paymentForm.addEventListener('submit', function(event) {
                               /* if(isSubscriptionProductPresent) {
                                    if(!$("#rememberMe").is(':checked')) {
                                        alert("You have subscription product in your cart.So It is required to select the Save Payement option for future payments.");
                                        //return ;
                                    }
                                }*/
                               console.log('going to create source');
                                event.preventDefault();
                                $("#overlayDivNew").css("display", "block");
                                populateUserInformation();
                                //event.stopPropagation();
                                $('#submitCCPayment').attr('disabled','true');
                                var grandtotal = CCRZ.cartCheckoutModel.attributes.subTotal + CCRZ.cartCheckoutModel.attributes.tax + (CCRZ.cartCheckoutModel.attributes.shippingCharge == undefined ? 0 : CCRZ.cartCheckoutModel.attributes.shippingCharge) + (CCRZ.cartCheckoutModel.attributes.surchargeAmount ==  undefined ? 0 :CCRZ.cartCheckoutModel.attributes.surchargeAmount);
                                console.log('grandtotal---->'+grandtotal);
                                debugger;
                                var payload = {
                                    "type": "creditCard",
                                    "owner": {
                                        firstName: document.getElementById('firstName').value,
                                        lastName: document.getElementById('lastName').value,
                                        email: document.getElementById('email').value,
                                        phoneNumber: CCRZ?.cartCheckoutModel?.attributes?.buyerPhone,
                                        address: {
                                            line1: document.getElementById('address').value,
                                            line2: document.getElementById('address2').value,
                                            city: document.getElementById('city').value,
                                            state: document.getElementById('state').value,
                                            postalCode: document.getElementById('zip').value,
                                            country: document.getElementById('country').value
                                        },
                                    },
                                    "amount": grandtotal,
                                    "currency": CCRZ.cartCheckoutModel.attributes.currencyISOCode
                                }
                                //debugger
                                digitalriverjs.createSource(cardNumber,payload).then(function(result) {
                                    //debugger;
                                    if(isSubmitClicked){
                                        isSubmitClicked =false;
                                    }
                                    else{
                                        return false;
                                    }
                                    if(result.source == null){
                                        if(typeof  CCRZ.pagevars.pageLabels.DR_error_message_for_payments != 'undefined'){
                                            showMessageToastCC('fail', CCRZ.pagevars.pageLabels.DR_error_message_for_payments);
                                        }else{
                                            showMessageToastCC('fail', 'DR_error_message_for_payments');
                                        }
                                        $('#submitCCPayment').attr('disabled','false');
                                        $("#overlayDivNew").css("display", "none");
                                    }else if(result.error) {
                                        //Something went wrong, display the error message to the customer
                                        handleCreateSourceErrors(result.error);
                                        $('#submitCCPayment').attr('disabled','false');
                                        $("#overlayDivNew").css("display", "none");
                                        
                                    }else {
                                        //Success!  You can now send the token to your server for use in downstream API calls.
                                        var source = result.source;
                                       // debugger;
                                        sourceId = source.id; 
                                        callSubmitCreditCardPayment(sourceId,$("#rememberMe").is(':checked'),$("#nickName").val());
                                        
                                    }
                                });
                            });
                            function changeSubmitBtn(isCardnumberComplete,isCardExpiration,isCardCvv){
                                if(isCardnumberComplete && isCardExpiration && isCardCvv){
                                    $('#submitCCPayment').prop("disabled", false);
                                }else{
                                    $('#submitCCPayment').prop("disabled", true);
                                }
                            }
                            function handleErrors(error) {                                
                                var errorMessage = document.getElementById('message');
                                errorMessage.innerHTML = error.message;
                            }
                            function handleCreateSourceErrors(sourceError) {
                                if(typeof  sourceError.errors[0].message != 'undefined' &&  sourceError.errors[0].message != null &&  sourceError.errors[0].message != '' ){
                                    showMessageToastCC('fail', sourceError.errors[0].message);
                                }else if(typeof sourceError.type  != 'undefined' &&  sourceError.type != null && sourceError.type != '' ){
                                    if(typeof  CCRZ.pagevars.pageLabels.DR_error_message_for_payments != 'undefined'){
                                        showMessageToastCC('fail', CCRZ.pagevars.pageLabels.DR_error_message_for_payments);
                                    }else{
                                        showMessageToastCC('fail', 'DR_error_message_for_payments');
                                    }
                                }else{
                                    if(typeof  CCRZ.pagevars.pageLabels.DR_error_message_for_payments != 'undefined'){
                                        showMessageToastCC('fail', CCRZ.pagevars.pageLabels.DR_error_message_for_payments);
                                    }else{
                                        showMessageToastCC('fail', 'DR_error_message_for_payments');
                                    }
                                }
                            }
                            function callSubmitCreditCardPayment(sourceId,saveCardToWallet,savedCardOptionName) {
                                var cartId = CCRZ.cartCheckoutModel.attributes.sfid;
                                intilizeCCPaymentRemoting();
                                CCRZ.subsc.processCCPayments.submitCreditCardPayment(cartId, sourceId,saveCardToWallet,savedCardOptionName,false,'cc');
                            }
                            function intilizeCCPaymentRemoting(){
                                CCRZ.subsc = _.extend(CCRZ.subsc||{});
                                CCRZ.subsc.processCCPayments= _.extend(CCRZ.RemoteInvocation,{
                                    className : 'digitalriverb2b.DRB2B_PaymentController',
                                    submitCreditCardPayment: function(cartId, sourceId,saveCardToWallet,savedCardOptionName,isDefaultPayment,paymentType) {
                                        var data = {ccCartId : cartId,sourceId : sourceId,saveCardToWallet : saveCardToWallet,savedCardOptionName : savedCardOptionName,isDefaultPayment : isDefaultPayment,paymentType : paymentType };
                                        this.invokeCtx('submitPayments',JSON.stringify(data),                                   
                                            function(result, event) {
                                                //debugger;
                                                    isSubmitClicked =true;
                                                    $("#submitCCPayment").removeClass("validated");
                                                    $("#submitCCPayment").addClass("clientValidation");
                                                    $('#submitCCPayment').removeAttr("type").attr("type", "button");
                                                    if(event.status){
                                                    $('#submitCCPayment').attr('disabled','false');
                                                    //$("#overlayDivNew").css("display", "none");
                                                    if(result.error || !result.data) {
                                                        if(typeof  CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED != 'undefined'){
                                                            showMessageToastCC('fail', CCRZ.pagevars.pageLabels.DR_SERVER_PAYMENT_FAILED);
                                                        }else{
                                                            showMessageToastCC('fail', 'DR_SERVER_PAYMENT_FAILED');
                                                        }
                                                    }else if(!result.success || typeof  result.data.ERROR != 'undefined' && result.data.ERROR.length > 0) {
                                                        if(typeof  CCRZ.pagevars.pageLabels.Error_while_submitting_payments != 'undefined'){
                                                            showMessageToastCC('fail', CCRZ.pagevars.pageLabels.Error_while_submitting_payments);
                                                        }else{
                                                            showMessageToastCC('fail', 'Error_while_submitting_payments');
                                                        }
                                                    }else {
                                                        setTimeout(function(){ CCRZ.pubSub.trigger('action:processPayment', result.data['txObject']); }, 3000);
                                                    }
                                                }else{
                                                    if(event.type == 'exception'){
                                                        if(typeof  CCRZ.pagevars.pageLabels.Error_while_submitting_payments != 'undefined'){
                                                            showMessageToastCC('fail', event.message);
                                                        }else{
                                                            showMessageToastCC('fail',  CCRZ.pagevars.pageLabels.Error_while_submitting_payments);
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                buffer:false, //this call will be executed by itself
                                                nmsp : false,//defines that this is a call to a subscriber class
                                                timeout: 120000
                                            }
                                        );//end invokeCtx call
                                    }
                                });
                            }
                            $("#overlayDivNew").css("display", "none");
                        }
                 
                    </script>
                    <!--- Populate User Information-->
                    <script>
                        var isSubmitFormValidated =false;
                        function populateUserInformation() {
                            $("#firstName").val(CCRZ.cartCheckoutModel.attributes.billingAddress.firstName);
                            $("#lastName").val(CCRZ.cartCheckoutModel.attributes.billingAddress.lastName);
                            //$("#email").val(CCRZ.currentUser.Email);
                            $("#email").val(CCRZ.cartCheckoutModel.attributes.buyerEmail);
                            $("#city").val(CCRZ.cartCheckoutModel.attributes.billingAddress.city);
                            $("#state").val(CCRZ.cartCheckoutModel.attributes.billingAddress.stateCode);
                            $("#zip").val(CCRZ.cartCheckoutModel.attributes.billingAddress.postalCode);
                            $("#country").val(CCRZ.cartCheckoutModel.attributes.billingAddress.countryCode == undefined ? CCRZ.cartCheckoutModel.attributes.billingAddress.addressList[0].countryCode : CCRZ.cartCheckoutModel.attributes.billingAddress.countryCode);
                            $("#address").val(CCRZ.cartCheckoutModel.attributes.billingAddress.address1);
                            $("#address2").val(CCRZ.cartCheckoutModel.attributes.billingAddress.address2);
                        }
                        function submitFormValidationCC(){
                            $("#messageDivCC").hide();
                            if(isSubscriptionProductPresent) {
                                if(!$("#rememberMe").is(':checked')) {
                                   // alert("You have subscription product in your cart.So It is required to select the Save Payement option for future payments.");
                                   if(typeof  CCRZ.pagevars.pageLabels.DR_SELECT_SAVE_PAYMENT_OPTION != 'undefined'){
                                        showMessageToastCC('fail', CCRZ.pagevars.pageLabels.DR_SELECT_SAVE_PAYMENT_OPTION);
                                    }else{
                                        showMessageToastCC('fail', 'DR_SELECT_SAVE_PAYMENT_OPTION');
                                    }
                                    //return ;
                                }else if($("#rememberMe").is(':checked') && (typeof $("#nickName").val() == 'undefined' ||  $("#nickName").val() == '')){
                                    //alert("Card Name Required for Saved Payment.");
                                    if(typeof  CCRZ.pagevars.pageLabels.DR_CARD_NAME_REQUIRED != 'undefined'){
                                        showMessageToastCC('fail', CCRZ.pagevars.pageLabels.DR_CARD_NAME_REQUIRED);
                                    }else{
                                        showMessageToastCC('fail', 'DR_CARD_NAME_REQUIRED');
                                    }

                                }else {
                                    $('#submitCCPayment').removeAttr("onclick");
                                    $('#submitCCPayment').removeAttr("type").attr("type", "submit");
                                    $("#submitCCPayment").addClass("validated");
                                    $("#submitCCPayment").removeClass("clientValidation");
                                    $( "#submitCCPayment" ).trigger("click");
                                }
                            }else if($("#rememberMe").is(':checked') && (typeof $("#nickName").val() == 'undefined' ||  $("#nickName").val() == '')){
                                //alert("Card Name Required for Saved Payment.");
                                if(typeof  CCRZ.pagevars.pageLabels.DR_CARD_NAME_REQUIRED != 'undefined'){
                                    showMessageToastCC('fail', CCRZ.pagevars.pageLabels.DR_CARD_NAME_REQUIRED);
                                }else{
                                    showMessageToastCC('fail', 'DR_CARD_NAME_REQUIRED');
                                }
                            }else{
                                $('#submitCCPayment').removeAttr("onclick");
                                $("#submitCCPayment").addClass("validated");
                                $('#submitCCPayment').removeAttr("type").attr("type", "submit");
                                $("#submitCCPayment").removeClass("clientValidation");
                                $( "#submitCCPayment" ).trigger( "click" );
                            }
                        }
                        function showMessageToastCC(errorType,errorMsg){
                            if($("#messageDivCC").length < 1){
                                $( "#payment-form" ).prepend( '<div id="messageDivCC" class="alert alert-danger" style="margin-top:11px;display:none;"><a href="#" class="close" data-dismiss="alert" aria-label="close" title="close">×</a><span id="messageTextCC"></span></div>');
                            }
                            if(errorType == 'success'){
                                $("#messageDivCC").removeClass('alert-danger').addClass('alert-success');
                                $("#messageTextCC").removeClass('alert-danger').addClass('alert-success');
                                $("#messageTextCC").text(errorMsg);
                                $("#messageDivCC").show();
                            }else{
                               // $("#successMsgDiv").removeClass('alert-success').addClass('alert-danger');
                               // $("#messageTextCC").removeClass('alert-success').addClass('alert-danger');
                                $("#overlayDivNew").css("display", "none");
                                $("#messageTextCC").html(errorMsg);
                                $('#submitCCPayment').removeAttr('disabled');
                                $("#messageDivCC").show();
                            }
                        }
                        function openTaxExemptModal(){  
                           // debugger; 
                            populatePageLabels();   
                            $("#taxModal").show();  
                            $(".loader").show();    
                            $('#CertificateTable').hide();  
                            $('.taxCertificateFormValid').hide();   
                            $('#MyTaxCertificateUploadForm').hide();    
                            $('.manageTaxExemption').hide();    
                            var reqcheckCertificateStatus = { 'userId': '{!$User.Id}' };    
                            var ajaxData = JSON.stringify(reqcheckCertificateStatus);   
                            intilizeTaxRemoting();  
                            CCRZ.subsc = _.extend(CCRZ.subsc || {});    
                           // debugger; 
                            CCRZ.subsc.MyRemote.checkCertificateStatus(ajaxData);   
                        }
                    </script>
                    <script>
                        var rememberMe=false;
                        var nickName ="";
                        function saveforfuture(){
                            if($("#rememberMe").is(':checked')){
                                rememberMe=true;
                                nickName  = $("#nickName").val();
                                $("#showhideemail").show();
                            }else{
                                rememberMe=false;
                                $("#nickName").val("");
                                $("#showhideemail").hide();
                            }
                        }
                    </script>
                <script>
                    $(document).on("click", "a.close" , function() {
                       // debugger;
                        $( "#payment-form" ).prepend( '<div id="messageDivCC" class="alert alert-danger" style="margin-top:11px;display:none;"><a href="#" class="close" data-dismiss="alert" aria-label="close" title="close">×</a><span id="messageTextCC"></span></div>');
                    });
                    $(document).on("click", "button.clientValidation" , function() {
                      //  debugger;
                        if(!$("#submitCCPayment").hasClass("validated"))
                            submitFormValidationCC();
                    });
                    $(document).on("click", "a.cc_nav-tabs_anchor" , function() {
                        if($(this).attr("href").trim() !== "#cc") 
                            $("#messageDivCC").hide();
                    });
            </script>
        </body>
    </html>
