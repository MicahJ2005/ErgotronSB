                                        <div class="ccrow" id="showhideemail" style="display: none;margin: 5px;margin-top: -5px; margin-right: 5px;margin-bottom: 5px;margin-left: 5px;">
                                            <div style="display: inline-grid; width:30%;">
                                                <input class="placeHolderText field DRElement DRElement--empty" id="nickName" placeholder="Card Name" name="email" type="text"/>
