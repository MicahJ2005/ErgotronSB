                                        <img id="card-image" src="https://www.ergotron.com/portals/0/html/store/img/credit-cards.png" />
                                        <div class="ccrow" style="margin:5px;">
                                            <label for="card-number" class="lbl-card-number">Credit Card Number</label>
                                            <div id="card-number" class="field row-column50"></div>
