                    left: 0;
                    right: 0;
                    bottom: 0;
                    background-color: rgba(0,0,0,0.5); 
                    z-index: 2; 
                    cursor: pointer; 
                }
                .messageDivCCCss {                    
                    z-index: 99999999;
                    position: fixed;
                    top: 10%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    display :none;
                }
            </style>
        </head>
