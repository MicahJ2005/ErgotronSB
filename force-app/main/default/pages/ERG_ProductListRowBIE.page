            if(ele[i].checked)
            {
                   selected_location = ele[i].value;            
                   CCRZ.subsc.customActions.updatecart(selected_location,SKU,qnty, function(response){  
					   CCRZ.pubSub.trigger('cartChange', CCRZ.pagevars.currentCartID);                       
                       //  CCRZ.cartView.update();
                       //alert("updatecart response 2= "+response.data.key1+" "+response.data.key2);  
             });
        }
    }

    //CCRZ.pubSub.trigger('cartChange', CCRZ.pagevars.currentCartID);                       
    //CCRZ.productListPageView.render();
    //CCRZ.cartView.update();
    
    // may need another spinner
    //    location.reload();  

    // these are supposed to update but they don't    
    //CCRZ.cartView.update();
    //CCRZ.headerView.update();    
    

 
}

    
    
</script>   
    
    
    
    
    
    
