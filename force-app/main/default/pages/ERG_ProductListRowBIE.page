<apex:page docType="html-5.0" sidebar="false" showHeader="false" standardStylesheets="false"  controller="CC_ERG_ctrl_PDP">
	<script id="ERGProductListRow" type="text/template"> 
    
  <div class="cc_product_item cc_row_item">
   <div class="panel panel-default cc_panel">
    <div class="panel-body cc_body"> 
     <div class="messagingSection-Warning-{{this.sfid}}" style="display: none"></div>
     <div class="messagingSection-Info-{{this.sfid}}" style="display: none"></div>
     <div class="messagingSection-Error-{{this.sfid}}" style="display: none"></div>
     
    
     <div class="cc_product_item_row row">
         
         
      
         
     <!-- Title col 1 -->
     <div class="col-xs-6" > 
       <!-- title -->
       <p class="cc_product_link">
        {{#if this.alternateName}}
         {{productLink this 'cc_product_name' text=this.alternateName}}
        {{else}}
         {{productLink this 'cc_product_name' text=this.sfdcName}}
        {{/if}}
        <br>SKU: {{this.SKU}}
       </p>
        </div>

        <!-- col 2  quantity form --> 
         <div class="col-xs-2">  
       
       {{#ifDisplay 'PL.DsplAddCart'}}
        {{#unless this.showNewSubscriptionSelection}}
         {{#if this.canAddtoCart}}
          {{> productQuantityControls}}
          <div class="action cc_action wishFinder row">
           <div class="cc_add_to col-xs-12 col-md-6 form-group">
           </div>
          </div>
         {{/if}}
        {{/unless}}
       {{/ifDisplay}}
        
        </div>
        
        
		<!-- col 3 price -->
		<div class="col-xs-2">
        	<div class="cc_price_container cc_row_price_info">
    	    {{>priceDisplay}}
	        </div>
        </div>
         
            
       <!-- col 4  buttons-->
      <div class="col-xs-2">
         <!-- add to cart button -->
		<button class="btn btn-default btn-block btn-sm cc_add_to_btn cc_add_to_btn_{{this.sfid}}" role="button">{{pageLabelMap 'ProductList_AddToCart'}}</button>
		<!-- <button class="btn btn-default btn-block btn-sm " role="button">Availability</button> -->
<!--         <Br><a  href="#warehousebutton"  onclick="warehouserequest('LTSC20WH/SM', 'hardcoded data');" style="text-decoration: none; margin: 0; padding: 0;"  id="additionalInfoLink" data-toggle="modal"><button class="btn btn-default btn-block btn-sm " role="button" >Availability</button></a> -->
       <Br/><a  href="#warehousebutton"  onclick="warehouserequest('{{this.SKU}}', '{{this.sfdcName}}', '{{this.sfid}}');" style="text-decoration: none; margin: 0; padding: 0;"  id="additionalInfoLink" data-toggle="modal"><button class="btn btn-default btn-block btn-sm " role="button" >Availability</button></a>
            
            
            
	</div>
       
     </div>  <!-- end of action row -->

        
        
        
     <div class="cc_product_item_row row ">
       {{#ifDisplay 'PL.DsplShortDesc'}}
        <div class = " description cc_desc col-xs-12">
         {{unescape shortDesc}} <Br>
        </div>
       {{/ifDisplay}}
     </div>  <!-- end of description row -->  

       
       
       
    </div>
  </div>
</div>    
 <hr style="color:blue;"> 
 
       
</script>    
    
    
    
