<script type="text/javascript">
    
jQuery(function ($) {
    //	debugger;
    CCRZ.subsc = _.extend(CCRZ.subsc || {});

    CCRZ.subsc.customActions = _.extend({
	className: 'CC_ERG_ctrl_PDP',
	doATPForStore: function (SKU, callback) {
	    this.invokeCtx('doATPForStore', SKU, function (response) {
		    callback(response);
		},
		{
		    buffer: false, nmsp: false
		}
	    );
	},

	updatecart: function (location, SKU, qty, callback) {
	    this.invokeCtx('updatecart', location, SKU, qty, function (response) {
		    callback(response);
		},
		{
		    buffer: false, nmsp: false
		}
	    );
        
	},                

    }, CCRZ.RemoteInvocation);
    
    
    //var pl_and_ordertype = 'Ordertype = '+{!theOrderType};
    //var pl_and_ordertype = 'Ordertype = '+{!theOrderType}+' Pricelist = '+{!thePriceList};
    var pl_and_ordertype = 'Ordertype = {!theOrderType} &nbsp;&nbsp;&nbsp;Pricelist = {!thePriceList}';
    
    
    
    //    document.getElementById("PLOT").innerHTML = 'updatea data here' ;
    document.getElementById("PLOT").innerHTML = pl_and_ordertype;
    
  
    
    
});

function warehouserequest(SKU,ProductName,sfid) {
  CCRZ.subsc.customActions.doATPForStore(SKU, function(response){
      
      var html = '<h1>'+ProductName+'<br><br>SKU: '+SKU+'</h1>';
      var number_returned=0;
      
      var input_field_id = sfid+'_qtyEntry';
      var qnty = document.getElementById(input_field_id).value;
      //      alert("qnty = "+qnty);
      
      // debugger;
      
 	  if( !response.success || response === undefined  )
      {
		number_returned=0;
      }
      else
	  {
          
        if( response.data === undefined || response.data.atpresult === undefined )
        {
			number_returned=0;
        }
        else
        {
            number_returned=response.data.atpresult.length;
        }
	  }     

      if( number_returned > 0 )
      {
	      html += '<form><table border="0" id="warehousecontent"><tr> <td><B>Location</b></td> <td><B>Quantity on Hand</b></td></tr>';
          for(var cnt = 0; cnt < response.data.atpresult.length; cnt++){
            html += '<tr> <td><input type="radio" name="location" value="' + response.data.atpresult[cnt].ORGANIZATION_CODE + '">'+ response.data.atpresult[cnt].ORGANIZATION_CODE +'</td><td>' + response.data.atpresult[cnt].QTY_AVAIL + '</td> </tr>';
          }
		  html += '</table><Br><Br>   <input type="button" value="Update Cart" onclick="FormAction(\''+SKU+'\',\''+qnty+'\')" data-dismiss="modal" > </form>';
      }
      else
      {
          html += '<b>This item is not currently found in any warehouse.</b><br/><br/> Please contact the help desk';
      }
 
      document.getElementById("dynamicContent").innerHTML = html;
      
      
  });
}

    
$('#warehousebutton').on('hidden.bs.modal', function () {
    
    var html='<br/><br/><br/><br/><br/>\
<span style="display: inline-block; padding: 10px 0px;">Checking Warehouse Availability ...</span>\
                       \
<div style="position: fixed; left: 0; top: 0; bottom: 0; right: 0; z-index: 1001; margin: 15% 50%">\
<div style="display: inline-block; padding: 2px; background-color: #fff;   text-align: center">\
<img src="/auraFW/resources/aura/images/spinner.gif" style="float: left; margin: 8px;" />\
</div>\
</div>\
';    
    
          document.getElementById("dynamicContent").innerHTML = html;
    
});    
    

