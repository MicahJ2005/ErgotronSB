<apex:page controller="ProductComparisonWizardController" title="Product Comparison" readOnly="true">
	<head>
		<apex:includescript value="//code.jquery.com/jquery-1.11.3.min.js" / >
		<apex:includescript value="//cdn.datatables.net/1.10.10/js/jquery.dataTables.min.js" />
		<apex:stylesheet value="//cdn.datatables.net/1.10.10/css/jquery.dataTables.css" />
		<script>
			j$ = jQuery.noConflict();
			j$(document).ready( function () {
				var productComparisonTable = j$('[id$="productComparisonTable"]').DataTable({
        			 "sDom": '<"toolbar">frtip'
        			 ,"ordering" : false
        			 ,"paging" : false
				});
				j$("a[id$=xlslink]").detach().appendTo("div.toolbar")
				//j$("div.toolbar").html("<b><a href=\"{!URLFOR($Page.ProductComparisonXLS,null,['generate'=1,'excel'=true])}\">Click to download XLS file</a></b>");
			});
		</script>
		<style>
			.toolbar{
				display: inline-block;
			}

		    .dataTables_wrapper{
		    	padding: 25px;
		    }
		</style>
	</head>
	<body>
		<apex:form id="linkform"><apex:commandLink id="xlslink" action="{!displayComparisonXLS}" value="Click to download XLS file" /></apex:form>
		<table id="productComparisonTable" class="display">
		    <thead>
			<tr>
				<th>
					Product Attribute
				</th>
				<apex:repeat value="{!mapComparison}" var="key">
					<th>{!mapComparison[key].Name}</th>
				</apex:repeat>
			</tr>
			</thead>
			<tbody>
			<apex:repeat value="{!lstObjectFieldsDisplay}" var="field">
				<tr>
					<td>{!$ObjectType['Ergotron_Product_Comparison__c'].fields[field].Label}</td>
					<apex:repeat value="{!mapComparison}" var="key">
						<td>{!mapComparison[key][field]}</td>
					</apex:repeat>
				</tr>
			</apex:repeat>
			</tbody>
		</table>
	</body>
</apex:page>