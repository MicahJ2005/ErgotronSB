<apex:page showHeader="false">
    <script src="https://www.google.com/recaptcha/api.js" async="true" defer="true" />
    <div class="g-recaptcha" data-sitekey="{!$Setup.reCaptchaGoogle__c.PublicKey__c}" data-callback="handleVerification"></div>
    <script type="text/javascript">
        function handleVerification(message){
            parent.postMessage(message, location.origin);
        }
    </script>
</apex:page>