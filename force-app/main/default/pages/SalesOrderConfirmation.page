<apex:page standardController="Sales_Order__c" extensions="Sales_Order_Confirmation_Cntrl" docType="html-5.0">
    <apex:includeScript value="{!$Resource.jQuery1111}" />

    <script type="text/javascript">    
        var j$ = jQuery.noConflict();

        function disableButtons()
        {    
            j$("#divLoading").show();
            j$("input[type='button']").prop({disabled: true});
            j$("input[type='submit']").prop({disabled: true});
        }

        function enableButtons()
        {
            j$("#divLoading").hide();
            j$("input[type='button']").prop({disabled: false});
            j$("input[type='submit']").prop({disabled: false});           
        }
    </script>
    
    <apex:form id="mainForm">
        <apex:pageMessage severity="info" strength="3" summary="{!$Label.Sales_Order_Confirmation}" /><br/>
        <apex:pageMessages id="pageMessages"/>
        <apex:actionStatus id="submittingOrder" onstart="disableButtons()" onstop="enableButtons()" />
        <!-- Submit/Cancel Buttons -->
        <apex:commandButton action="{!orderConfirmationSubmit}" value="Submit Order" id="btnSubmit" status="submittingOrder" rerender="btnSubmit,btnCancel,btnEdit,btnEditShipTo,divLoading,pageMessages"/>&nbsp;&nbsp;
        <apex:commandButton action="{!cancel}" value="Cancel" id="btnCancel"/><br/><br/>

        <div id="divLoading" align="center" style="display: none;">
            <div style="color:red; font-style:italic"><img  src="{!$Resource.loadingimg}" />&nbsp;&nbsp;Submitting Order Details...</div>
        </div>

        <apex:pageblock title="Sales Order Details">
            <apex:commandButton action="{!editOrderDetails}" value="Edit Order Details" id="btnEdit"/><br/>
            <apex:pageBlockSection columns="2" collapsible="false" >
                <apex:outputField value="{!Sales_Order__c.Order_Type__c}" />
                <apex:outputText value="{!Sales_Order__c.Ship_To_Contact_First_Name__c + ' ' + Sales_Order__c.Ship_To_Contact_Last_Name__c}" label="Ship To Contact"/>
                <apex:outputField value="{!Sales_Order__c.Bill_To_Customer__r.Name}" label="Bill To Customer"/>
                <apex:outputField value="{!Sales_Order__c.Ship_To_Contact_Email__c}" />
                <apex:outputField value="{!Sales_Order__c.Ship_To_Customer__r.Name}" label="Ship To Customer"/>
                <apex:outputField value="{!Sales_Order__c.Ship_To_Contact_Phone__c}" />
                <apex:outputField value="{!Sales_Order__c.Notes__c}" />
                <apex:outputField value="{!Sales_Order__c.Customer_PO_Number__c}" />

                <!-- Hidden fields used by the controller extension -->
                <apex:outputField rendered="false" value="{!Sales_Order__c.Ship_To_Contact_Role_Id__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Ship_To_Customer__r.Oracle_Party_Id__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Ship_To_Customer_Account__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Ship_To_Customer_Id__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Ship_To_Org_Id__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Bill_To_Customer_Account__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Bill_To_Customer_Id__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Order_Submitted__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.Date_Time_Submitted__c}" />
                <apex:outputField rendered="false" value="{!Sales_Order__c.ORIG_SYS_DOCUMENT_REF__c}" />
            </apex:pageBlockSection>
        </apex:pageBlock>

        <apex:pageblock title="Ship To Location Details">
            <apex:commandButton action="{!selectShipTo}" value="Edit Ship To Location" id="btnEditShipTo"/><br/>
            <apex:pageBlockSection columns="1" collapsible="false" >
                <apex:outputField value="{!Sales_Order__c.Ship_To_Address__c}" />
            </apex:pageBlockSection>
        </apex:pageblock>
    </apex:form>
    <apex:relatedList list="Sales_Order_Lines__r" />
</apex:page>