<apex:page showHeader="true" sidebar="true" standardController="Sales_Order__c" extensions="Sales_Order_New_Controller" docType="html-5.0">
<!--    <apex:includeScript value="{!$Resource.jQuery211}" />

    <script type="text/javascript">    
