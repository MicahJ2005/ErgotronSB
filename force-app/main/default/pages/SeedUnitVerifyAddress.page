<!-- This page will be launched from the "SeedUnitSelectShipTo.page" when the user saves a new US address when creating a seed unit order.  This page
will display the results from the SmartyStreets address verification service or an error if no address was found. -->
<apex:page standardController="Seed_Unit_Order__c" extensions="Seed_Unit_Verify_Address_Controller" docType="html-5.0">
	<apex:form id="mainForm">
		<apex:pageMessage severity="info" strength="3" summary="{!$Label.Address_Verification_Message}" escape="false" rendered="{!bDisplayVerifiedAddress}"/><br/>	
		<apex:pageMessage severity="warning" strength="3" summary="{!$Label.Address_Verification_No_Results_Message}" escape="false" rendered="{!!bDisplayVerifiedAddress}"/><br/>	
		<apex:pageMessages id="pageMessages"/>

		<apex:pageblock id="verifiedAddressBlock" title="Verified Address(es)" rendered="{!bDisplayVerifiedAddress}">	
			<apex:outputPanel id="verifiedAddressPanel">
				<apex:pageblocktable value="{!listAddressResponses}" var="address" id="addressTable" style="width:100%">
					<apex:column headervalue="Matched Address" style="width:15%">
						<apex:outputtext rendered="{!address.addressee!=NULL}">
							<apex:outputtext value="{!address.addressee}" /><br/>
						</apex:outputtext>
						<apex:outputtext value="{!address.sFormattedAddress1}"/><br/>
						<apex:outputtext rendered="{!address.sFormattedAddress2!=NULL}">
							<apex:outputtext value="{!address.sFormattedAddress2}" /><br/>
						</apex:outputtext>
						<apex:outputtext value="{!address.sFormattedCityStateZip}" />&nbsp;&nbsp;
					</apex:column>
					
					<apex:column >                    
	                	<apex:commandButton value="Use This Address" action="{!updateAddress}" reRender="verifiedAddressPanel" style="valign:center">
	                		<apex:param name="addressIndex" value="{!address.candidate_index}" assignTo="{!sSelectedAddress}" />
	                	</apex:commandButton>
					</apex:column>			
				</apex:pageblocktable>
			</apex:outputPanel>
		</apex:pageblock>
		
		<apex:pageblock title="Ship To Address Entered">
			<apex:commandButton action="{!verifyCancel}" value="Cancel" id="btnCancel"/>&nbsp;&nbsp;
			<apex:commandButton action="{!editShipTo}" value="Change" id="btnEditShipTo"/>&nbsp;&nbsp;
			<apex:commandButton action="{!useAddressEntered}" value="Use Address As Entered" id="btnUseAddress"/><br/><br/>
			<apex:outputField value="{!Seed_Unit_Order__c.Ship_To_Address__c}" label=""/>
			<!-- Hidden fields used by the controller extension -->
			<apex:outputField rendered="false" value="{!Seed_Unit_Order__c.Ship_To_Address1__c}" />
			<apex:outputField rendered="false" value="{!Seed_Unit_Order__c.Ship_To_Address2__c}" />
			<apex:outputField rendered="false" value="{!Seed_Unit_Order__c.Ship_To_City__c}" />
			<apex:outputField rendered="false" value="{!Seed_Unit_Order__c.Ship_To_State_Province__c}" />
			<apex:outputField rendered="false" value="{!Seed_Unit_Order__c.Ship_To_Postal_Code__c}" />
		</apex:pageblock>
	</apex:form>		
</apex:page>