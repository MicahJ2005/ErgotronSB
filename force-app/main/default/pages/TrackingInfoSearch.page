<apex:page standardController="Order__c" extensions="TrackingInfoSearchController" title="Order Tracking Search" id="pgMain" showHeader="{!IF(TEXT($Profile.UserType) = 'Guest', false, true)}">
	<script src="https://code.jquery.com/jquery-2.0.0.min.js" />

	<script type="text/javascript">    
        var j$ = jQuery.noConflict();

        function inputDisable() {
        	j$("input[type='button']").prop({disabled: true});
            j$("input[type='submit']").prop({disabled: true});
        }

        function inputEnable() {
        	j$("input[type='button']").prop({disabled: false});
            j$("input[type='submit']").prop({disabled: false});
        }

	    function startSave()
	    {    
            j$("#divSave").show();
            inputDisable();
	    }

	    function stopSave()
	    {
            j$("#divSave").hide();
            inputEnable();  
	    }

	    function statusShow() {
			j$( "#dialog-modal-chooser" ).dialog( "open" );
	    }

	    function statusHide() {
	    	j$( "#dialog-modal-chooser" ).dialog( "close" );
	    }

    </script>

    <apex:sectionHeader title="Order Tracking Information" subtitle="Show Information on Order Delivery Tracking" />

    <apex:form id="frmMain">
    <apex:actionStatus id="statusSave" onstart="startSave()" onstop="stopSave()" />
    <apex:inputHidden value="{!Order__c.Name}" />

    <apex:pageBlock title="Tracking Search">
        <apex:pageBlockButtons location="top">
            <apex:commandButton id="cmdSearch" value="Search" action="{!doSearch}" reRender="pbsResults" status="statusSave"/>
        </apex:pageBlockButtons>

        <apex:pageBlockSection title="Enter Criteria">
            <apex:pageBlockSectionItem >
                <apex:outputLabel value="Enter Order Number" for="txtOrderNumber" />
                <apex:inputText id="txtOrderNumber" value="{!strOrderNumber}" size="10" />
            </apex:pageBlockSectionItem>
            <apex:pageBlockSectionItem >
                <apex:outputLabel value="Enter PO Number" for="txtPONumber" />
                <apex:inputText id="txtPONumber" value="{!strPONumber}" size="10" />
            </apex:pageBlockSectionItem>
        </apex:pageBlockSection>

        <apex:pageBlockSection id="pbsResults" title="Tracking Results" columns="1">
	        <div id="divSave" align="center" style="display: none;">
		       	<div style="color:red; font-style:italic">Processing Request...</div>
		   	</div><br />
            <apex:pageBlockTable id="pbtResult" value="{!lstResults}" var="result">
                <apex:column headerValue="Order" rendered="{!IF(TEXT($Profile.UserType) = 'Guest', true, false)}">
                	<apex:outputText value="{!result.objOLI.Order__r.Name}" />
                </apex:column>
                <apex:column value="{!result.objOLI.Order__c}" rendered="{!IF(TEXT($Profile.UserType) = 'Guest', false, true)}"/>
                <apex:column headerValue="Line #">
                    <apex:outputText value="{!result.objOLI.Name}" />
                </apex:column>
                <apex:column headerValue="Part #">
                    <apex:outputText value="{!result.objOLI.Product_Code__c}" />
                </apex:column>
                <apex:column headerValue="Quantity">
                    <apex:outputField value="{!result.objOTN.Quantity__c}" />
                </apex:column>
                <apex:column headerValue="Carrier">
                    <apex:outputText value="{!result.objOTN.Carrier_Code__c}" />
                </apex:column>
                <apex:column headerValue="Tracking #">
                    <apex:outputLink rendered="{!result.objOTN.Carrier_Code__c == 'UPS'}" 
                        target="_blank" 
                        value="http://wwwapps.ups.com/WebTracking/track?loc=en_US&track.x=Track&trackNums={!result.objOTN.Tracking_Number__c}">
                        {!result.objOTN.Tracking_Number__c}
                    </apex:outputLink>
                    <apex:outputLink rendered="{!result.objOTN.Carrier_Code__c == 'FEDEX'}" 
                        target="_blank" 
                        value="http://fedex.com/Tracking?action=track&language=english&cntry_code=us&tracknumbers={!result.objOTN.Tracking_Number__c}">
                        {!result.objOTN.Tracking_Number__c}
                    </apex:outputLink>
                    <apex:outputText rendered="{!AND(NOT(result.objOTN.Carrier_Code__c == 'FEDEX'), NOT(result.objOTN.Carrier_Code__c == 'UPS'))}" 
                        value="{!result.objOTN.Tracking_Number__c}" 
                    />
                </apex:column>
                <apex:column headerValue="Ship Date">
                    <apex:outputField value="{!result.objOLI.Actual_Shipment_Date__c}" />
                </apex:column>
            </apex:pageBlockTable>
        </apex:pageBlockSection>
    </apex:pageBlock>

    </apex:form>

</apex:page>