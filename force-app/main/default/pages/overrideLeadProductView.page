<!-- This page is used to override the standard view action on the Lead_Product__c object and redirect the user to the associated Lead record -->
<apex:page standardController="Lead_Product__c" extensions="Lead_Product_Override" action="{!RedirectLead}">
	<apex:form >
		<apex:inputHidden value="{!Lead_Product__c.Lead__c}" id="hiddenLead"/>
	</apex:form>
</apex:page>